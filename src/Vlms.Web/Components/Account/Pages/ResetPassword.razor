@page "/Account/ResetPassword"
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(WebHardening.AccountFormsPolicy)]

@using System.ComponentModel.DataAnnotations
@using Vlms.Infrastructure.Identity

@inject AccountEmailService AccountEmails

@* Static SSR, same as Login.razor. Anonymous by necessity. The reset code from the emailed link is
   the authorisation: it's single-use and expires (VlmsIdentityPolicy); an unknown email reports
   success without changing anything (AccountEmailService: no enumeration). *@

<PageTitle>Reset password</PageTitle>

<div class="auth">
<PageHeader Title="Reset password" />

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}

@if (string.IsNullOrEmpty(Input.Code))
{
    <p role="alert">This reset link is incomplete. <a href="Account/ForgotPassword">Request a new one.</a></p>
}
else if (_done)
{
    <p role="status">Your password has been reset.</p>
    <p><a href="Account/Login">Log in</a></p>
}
else
{
    <EditForm class="form panel" Model="Input" method="post" OnValidSubmit="Reset" FormName="reset-password">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />
        <input type="hidden" name="Input.Code" value="@Input.Code" />

        <div class="field">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true" />
        </div>
        <div class="field">
            <label for="password">New password</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" aria-required="true" />
        </div>
        <div class="field">
            <label for="confirmPassword">Confirm new password</label>
            <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        </div>

        <div class="form-actions"><button type="submit">Reset password</button></div>
    </EditForm>
}
</div>

@code {
    // No property initializer — BL0008: see Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? _errorMessage;
    private bool _done;

    protected override void OnInitialized()
    {
        Input ??= new();
        if (string.IsNullOrEmpty(Input.Code))
        {
            Input.Code = Code ?? "";
        }
    }

    public async Task Reset()
    {
        var result = await AccountEmails.ResetPasswordAsync(Input.Email, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            _done = true;
            return;
        }

        _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required]
        public string Code { get; set; } = "";

        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
