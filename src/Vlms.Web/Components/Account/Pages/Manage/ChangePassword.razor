@page "/Account/Manage/ChangePassword"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Vlms.Infrastructure.Identity

@inject UserManager<VlmsIdentityUser> UserManager
@inject SignInManager<VlmsIdentityUser> SignInManager
@inject PasswordChangeService PasswordChanges

@* Static SSR, not interactive — RefreshSignInAsync writes the auth cookie, which needs a normal
   HTTP request/response cycle (same reason as TwoFactorAuthentication.razor). Plain [Authorize],
   any signed-in user, deliberately NOT an MFA-carrying policy: an Admin / Safeguarding Officer /
   Teacher without MFA can still reach it (as they can reach the MFA pages), and changing a
   password needs the current password anyway. A student account (no email, adr/0007) is refused
   here and again in PasswordChangeService: a student's password is set by their parent. *@

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>

@if (_user is null)
{
    <p>Loading...</p>
}
else if (_isStudent)
{
    <p role="alert">A student cannot change their own password. Ask your parent to reset it.</p>
}
else
{
    @if (_errorMessage is not null)
    {
        <p class="error" role="alert">@_errorMessage</p>
    }
    @if (_statusMessage is not null)
    {
        <p role="status">@_statusMessage</p>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <div>
            <label for="oldPassword">Current password</label>
            <InputText id="oldPassword" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" aria-required="true" />
        </div>
        <div>
            <label for="newPassword">New password</label>
            <InputText id="newPassword" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" aria-required="true" />
        </div>
        <div>
            <label for="confirmPassword">Confirm new password</label>
            <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        </div>

        <button type="submit">Change password</button>
    </EditForm>
}

@code {
    private VlmsIdentityUser? _user;
    private bool _isStudent;
    private string? _errorMessage;
    private string? _statusMessage;

    // No property initializer — BL0008: see Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (AuthenticationState is null)
        {
            return;
        }

        var principal = (await AuthenticationState).User;
        _user = await UserManager.GetUserAsync(principal);
        _isStudent = _user is not null && StudentSignInPolicy.IsStudentAccount(_user);
    }

    private async Task ChangeAsync()
    {
        if (_user is null || _isStudent)
        {
            return;
        }

        var result = await PasswordChanges.ChangeAsync(_user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(_user);
        _statusMessage = "Your password has been changed.";
        Input = new();
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
