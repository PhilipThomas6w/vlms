@page "/Account/ForgotPassword"
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(WebHardening.AccountFormsPolicy)]

@using System.ComponentModel.DataAnnotations
@using Vlms.Infrastructure.Identity

@inject AccountEmailService AccountEmails

@* Static SSR, same as Login.razor. Anonymous by necessity: the caller can't sign in. Shows the same
   message whether or not the email matches an account (AccountEmailService: no enumeration). *@

<PageTitle>Forgot your password?</PageTitle>

<div class="auth">
<PageHeader Title="Forgot your password?" />

@if (_submitted)
{
    <p role="status">If that email belongs to a confirmed account, we've sent a link to reset the password. It's valid for 2 hours.</p>
    <p><a href="Account/Login">Back to log in</a></p>
}
else
{
    <p>Enter your email address and we'll send you a link to choose a new password.</p>
    @* Student sign-ins have no email, so this flow can never reach one (adr/0007). *@
    <p>Students: your sign-in has no email address. Ask your parent to reset your password.</p>

    <EditForm class="form panel" Model="Input" method="post" OnValidSubmit="SendResetLink" FormName="forgot-password">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <div class="field">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true" />
        </div>

        <div class="form-actions"><button type="submit">Send reset link</button></div>
    </EditForm>
}
</div>

@code {
    // No property initializer — BL0008: see Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private bool _submitted;

    protected override void OnInitialized() => Input ??= new();

    public async Task SendResetLink()
    {
        await AccountEmails.RequestPasswordResetAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
