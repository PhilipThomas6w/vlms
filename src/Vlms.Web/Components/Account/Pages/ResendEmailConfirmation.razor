@page "/Account/ResendEmailConfirmation"
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(WebHardening.AccountFormsPolicy)]

@using System.ComponentModel.DataAnnotations
@using Vlms.Infrastructure.Identity

@inject AccountEmailService AccountEmails

@* Static SSR. Anonymous by necessity. Same message whether or not the email matches an
   unconfirmed account (AccountEmailService: no enumeration). *@

<PageTitle>Resend email confirmation</PageTitle>

<div class="auth">
<PageHeader Title="Resend email confirmation" />

@if (_submitted)
{
    <p role="status">If that email belongs to an account still waiting for confirmation, we've sent a new link. It's valid for 2 hours.</p>
    <p><a href="Account/Login">Back to log in</a></p>
}
else
{
    <EditForm class="form panel" Model="Input" method="post" OnValidSubmit="Resend" FormName="resend-confirmation">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <div class="field">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true" />
        </div>

        <div class="form-actions"><button type="submit">Resend</button></div>
    </EditForm>
}
</div>

@code {
    // No property initializer — BL0008: see Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private bool _submitted;

    protected override void OnInitialized() => Input ??= new();

    public async Task Resend()
    {
        await AccountEmails.ResendConfirmationAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
