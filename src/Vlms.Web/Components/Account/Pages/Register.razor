@page "/Account/Register"
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(WebHardening.AccountFormsPolicy)]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Vlms.Domain
@using Vlms.Infrastructure.Chapters
@using Vlms.Infrastructure.Identity

@inject NewRegistrationService Registrations
@inject ChapterService Chapters
@inject AccountEmailService AccountEmails

@* Static SSR, not interactive — same reasoning as Login.razor: SignInManager writes the auth
   cookie, which needs a normal HTTP request/response, not a live SignalR circuit.

   Scope decision (STATE.md "Identity" item, recorded rather than assumed): self-service registration
   stays open here, the same shape Microsoft Entra External ID's own hosted sign-up had before this
   item — a freshly created AppUser gets zero UserRole rows (deny-by-default,
   AppUserProvisioningService), so an anonymous registrant gains no access at all until an Admin
   grants a role (a separate, not-yet-built action, unchanged from before this item). This is how
   staff (Admin/Teacher/Approver/SafeguardingOfficer/Student) accounts get their initial credential —
   Parent accounts instead come from the guardian invite-accept flow
   (Components/Pages/Guardianship/AcceptInvite.razor), which is scoped to a specific Student/
   ParentGuardian pairing and does not use this page at all.

   The new account can't sign in until its email is confirmed (VlmsIdentityPolicy), so this page
   sends the confirmation link instead of signing the user in.

   FR-021 as amended 09/11/2026: the person chooses the chapter they are joining and what they are
   joining as. That grants nothing; it puts them on that chapter's "New registrations" list and
   emails its Admins (NewRegistrationService). *@

<PageTitle>Register</PageTitle>

<div class="auth">
<PageHeader Title="Register" />

<p class="muted">We use these details to create and secure your account. <a href="privacy">Privacy information</a> explains how we handle your information.</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}

@if (_registered)
{
    <p role="status">Account created. We've sent a confirmation link to your email address — open it to finish setting up your account, then log in.</p>
    <p><a href="Account/Login">Log in</a> · <a href="Account/ResendEmailConfirmation">Didn't get the email?</a></p>
}
else
{
<EditForm class="form panel" Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
    <DataAnnotationsValidator />
    <ValidationSummary role="alert" />

    <div class="field">
        <label for="displayName">Name</label>
        <InputText id="displayName" @bind-Value="Input.DisplayName" aria-required="true" />
    </div>
    <div class="field">
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true" />
    </div>
    <div class="field">
        <label for="chapter">Chapter you are joining</label>
        <InputSelect id="chapter" @bind-Value="Input.ChapterId" aria-required="true">
            <option value="">Choose a chapter</option>
            @foreach (var chapter in _chapters)
            {
                <option value="@chapter.Id">@chapter.Name, @chapter.Place</option>
            }
        </InputSelect>
    </div>
    <div class="field">
        <label for="joiningAs">Joining as</label>
        <InputSelect id="joiningAs" @bind-Value="Input.JoiningAs" aria-required="true">
            <option value="">Choose one</option>
            <option value="@JoiningAs.Parent">Parent</option>
            <option value="@JoiningAs.Teacher">Teacher</option>
            <option value="@JoiningAs.Other">Other</option>
        </InputSelect>
    </div>
    <div class="field">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" aria-required="true" />
    </div>
    <div class="field">
        <label for="confirmPassword">Confirm password</label>
        <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
    </div>

    <div class="form-actions"><button type="submit">Register</button></div>
</EditForm>
}

<div class="auth-links"><a href="Account/Login">Already have an account? Log in</a></div>
</div>

@code {
    // No property initializer — BL0008 (learn.microsoft.com/aspnet/core/diagnostics/bl0008): see
    // Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string? _errorMessage;
    private bool _registered;
    private IReadOnlyList<ChapterSummary> _chapters = [];

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _chapters = await Chapters.ListOpenAsync();
    }

    public async Task RegisterUser()
    {
        var (result, identityUser) = await Registrations.RegisterAsync(
            Input.Email, Input.Password, Input.DisplayName, Input.ChapterId!.Value, Input.JoiningAs!.Value);

        if (!result.Succeeded || identityUser is null)
        {
            _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await AccountEmails.SendConfirmationAsync(identityUser);
        _registered = true;
    }

    private sealed class InputModel
    {
        [Required]
        public string DisplayName { get; set; } = "";

        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Choose the chapter you are joining.")]
        public int? ChapterId { get; set; }

        [Required(ErrorMessage = "Choose what you are joining as.")]
        public JoiningAs? JoiningAs { get; set; }

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
