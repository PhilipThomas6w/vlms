@* The product mark: the Varangians logo's cross with IC XC / NI KA ("Jesus Christ conquers") in its
   quadrants (seed/admin/GraphicDesign/Logo.png), redrawn as a vector so it stays sharp at any size.
   Without Letters, the cross alone, for sizes where the letters can't be read. Decorative: the visible
   product name beside it is the accessible name. *@
<svg class="brand-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <g fill="currentColor">
        @* The arms flare out to concave ends, as on the logo. The crossbar sits a little above centre. *@
        <path d="M40.5 5 Q50 8 59.5 5 Q54 15 54 28 V83 Q54 90 60 96 Q50 93 40 96 Q46 90 46 83 V28 Q46 15 40.5 5 Z" />
        <path d="M5 34.5 Q8 43 5 51.5 Q15 46.5 28 46.5 H72 Q85 46.5 95 51.5 Q92 43 95 34.5 Q85 39.5 72 39.5 H28 Q15 39.5 5 34.5 Z" />
    </g>
    @if (Letters)
    {
        <g fill="currentColor" font-family="Source Sans 3, Segoe UI, sans-serif" font-weight="600" font-size="15" text-anchor="middle">
            <text x="27" y="31">IC</text>
            <text x="73" y="31">XC</text>
            <text x="27" y="70">NI</text>
            <text x="73" y="70">KA</text>
            <rect x="20" y="14.5" width="14" height="1.6" />
            <rect x="65" y="14.5" width="16" height="1.6" />
        </g>
    }
</svg>

@code {
    [Parameter] public bool Letters { get; set; }
}
