@* The interlace band: an Anglo-Saxon two-strand twist with true over-and-under crossings, drawn for this
   project (docs/design/redesign-direction.md, section 6). Strand colour is the text colour; the "gap"
   at each crossing is the ground colour (--band-ground), so the band works on lapis or on paper.
   Purely decorative. *@
<svg class="band @Class" aria-hidden="true" focusable="false" preserveAspectRatio="none">
    <defs>
        <pattern id="@_id" width="24" height="12" patternUnits="userSpaceOnUse">
            <rect width="24" height="12" style="fill: var(--band-ground)" />
            @* Strand B, full, underneath. *@
            <path d="M0 9 C6 9 6 3 12 3 S18 9 24 9" fill="none" stroke="currentColor" stroke-width="2" />
            @* Strand A on top: a ground-coloured halo, then the strand. *@
            <path d="M0 3 C6 3 6 9 12 9 S18 3 24 3" fill="none" style="stroke: var(--band-ground)" stroke-width="4.5" />
            <path d="M0 3 C6 3 6 9 12 9 S18 3 24 3" fill="none" stroke="currentColor" stroke-width="2" />
            @* Strand B again over the second crossing, so the strands alternate over and under. *@
            <path d="M13.5 3.6 C16 4.5 17 6.5 19 7.8" fill="none" style="stroke: var(--band-ground)" stroke-width="4.5" />
            <path d="M12 3 C15 3 16 5.4 18 7.2 S21.5 9 24 9" fill="none" stroke="currentColor" stroke-width="2" />
        </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#@_id)" />
</svg>

@code {
    [Parameter] public string? Class { get; set; }

    private readonly string _id = "band-" + Guid.NewGuid().ToString("N")[..8];
}
