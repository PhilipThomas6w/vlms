@using Vlms.Infrastructure.Engagement

@* Through the ranks: all ten as a procession (redesign-direction.md, section 7). Shared by the student
   page, the staff student record and the parent dashboard; CurrentLabel words the current station for
   the reader ("Your rank now" for the student, "Current rank" for staff and parents).
   (Never "The Way": that is the name of the faith itself.) *@
@if (Sidebar)
{
    @* The student page's sidebar: a complementary landmark that stays in view on wide screens. *@
    <aside class="the-way the-way--sticky" aria-labelledby="@HeadingId">@Body</aside>
}
else
{
    <section class="the-way" aria-labelledby="@HeadingId">@Body</section>
}

@code {
    private RenderFragment Body => @<text>
    @if (HeadingLevel == 3)
    {
        <h3 id="@HeadingId">Through the ranks</h3>
    }
    else
    {
        <h2 id="@HeadingId">Through the ranks</h2>
    }
    <ol class="the-way__list">
        @foreach (var rank in Ranks)
        {
            var movement = Movement(rank.Order);
            if (movement is not null)
            {
                <li class="the-way__movement" aria-hidden="true">@movement</li>
            }
            <li class="the-way__station is-@rank.State.ToString().ToLowerInvariant() rank-@rank.Order"
                aria-current="@(rank.State == JourneyRankState.Current ? "step" : null)">
                <RankMedallion RankId="rank.RankId" Order="rank.Order" RankName="@rank.Name"
                               HasBadgeImage="rank.HasBadgeImage" Earned="@(rank.BadgeAwardedAt is not null)"
                               Ahead="@(rank.State == JourneyRankState.Ahead)" Size="sm" Alt="" />
                <div class="the-way__text">
                    <span class="the-way__name">@rank.Name</span>
                    <span class="the-way__meta">@StationText(rank)</span>
                </div>
            </li>
        }
    </ol>
    </text>;

    [Parameter, EditorRequired] public IReadOnlyList<JourneyRank> Ranks { get; set; } = [];
    [Parameter] public string CurrentLabel { get; set; } = "Your rank now";
    [Parameter] public string HeadingId { get; set; } = "way-title";
    [Parameter] public int HeadingLevel { get; set; } = 2;
    [Parameter] public bool Sidebar { get; set; }

    // The stages of the procession through the ranks (direction doc, section 9), shown as labels between stations.
    private static string? Movement(int order) => order switch
    {
        1 => "Joining the Guard",
        5 => "Proclaiming",
        6 => "In the procession",
        9 => "Bearing Christ",
        10 => "Leading",
        _ => null,
    };

    private string StationText(JourneyRank rank) => rank.State switch
    {
        JourneyRankState.Past => rank.BadgeAwardedAt is { } earned ? $"Earned {earned:d MMMM yyyy}" : "Earned",
        JourneyRankState.Current when rank.Order == 10 => $"{CurrentLabel}: leadership and a wider programme",
        JourneyRankState.Current when rank.Lessons.Count == 0 => $"{CurrentLabel}. Lessons being written",
        JourneyRankState.Current => $"{CurrentLabel}: {rank.CompletedCount} of {rank.Lessons.Count} lessons",
        // Akolouthos is not a badge level: after Christ-bearer, a leadership role and a wider programme (syllabus scheme).
        _ when rank.Order == 10 => "After Christ-bearer: leadership and a wider programme",
        _ when rank.Lessons.Count == 0 => "Lessons being written",
        _ => $"{rank.Lessons.Count} lessons",
    };
}
