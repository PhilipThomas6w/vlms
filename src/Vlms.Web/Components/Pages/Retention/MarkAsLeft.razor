@page "/retention/mark-as-left"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Retention
@inject VlmsDbContext Db
@inject LeavingService LeavingService
@inject ICurrentUserContext CurrentUser

<PageTitle>Inactivity and student retention</PageTitle>

<PageHeader Title="Inactivity and student retention" />

<p class="intro">
    A manual action for Admins only. It is not inferred from disengagement or activity. Marking a Student as having left, or
    marking a staff member inactive in this chapter, records the date automatically (the moment you click the button, not a backdated date you choose)
    and feeds the <a href="/reporting/records-due-for-deletion">records due for deletion</a> retention report.
    This does not delete anything and does not affect promotions, badges, or certificates.
</p>
<p>
    A staff member marked Inactive loses access to this chapter but can still sign in. Their access to other chapters is unchanged.
    Reactivating restores the roles they held here. You can't mark yourself Inactive or reactivate yourself, or mark the last active Admin Inactive.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<h2>Students</h2>
@if (_activeStudents.Count == 0)
{
    <p>No Active students.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Student</th>
                <th>Enrolment date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in _activeStudents)
            {
                <tr>
                    <td data-label="Student">@student.Name</td>
                    <td data-label="Enrolment date">@student.EnrolmentDate.ToString("d MMMM yyyy")</td>
                    <td><button class="btn--secondary" aria-label="@($"Mark {student.Name} as left")" @onclick="() => MarkStudentInactiveAsync(student.Id)">Mark as left</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Staff</h2>
@if (_currentStaff.Count == 0)
{
    <p>No active Teachers, Admins or Safeguarding Officers.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>History</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in _currentStaff)
            {
                <tr>
                    <td data-label="Name">@member.DisplayName</td>
                    <td data-label="Email">@member.Email</td>
                    <td data-label="Roles">@RolesText(member)</td>
                    <td data-label="History">@foreach (var line in History(member)) { <div>@line</div> }</td>
                    <td>
                        @if (_confirming == (member.UserId, ConfirmKind.StepDown))
                        {
                            <p role="alert">Mark @member.DisplayName Inactive in this chapter?</p>
                            <button class="btn--danger" aria-label="@($"Confirm: mark {member.DisplayName} Inactive")" @onclick="() => MarkInactiveAsync(member.UserId)">Mark Inactive</button>
                            <button aria-label="@($"Cancel marking {member.DisplayName} Inactive")" @onclick="CancelConfirm" class="btn--secondary">Cancel</button>
                        }
                        else
                        {
                            <button class="btn--secondary" aria-label="@($"Mark {member.DisplayName} Inactive")" @onclick="() => AskToConfirm(member.UserId, ConfirmKind.StepDown)">Mark Inactive</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Inactive in this chapter</h2>
@if (_steppedDown.Count == 0)
{
    <p>Nobody is currently Inactive in this chapter.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>History</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in _steppedDown)
            {
                <tr>
                    <td data-label="Name">@member.DisplayName</td>
                    <td data-label="Email">@member.Email</td>
                    <td data-label="Roles">@RolesText(member)</td>
                    <td data-label="History">@foreach (var line in History(member)) { <div>@line</div> }</td>
                    <td>
                        @if (member.UserId == CurrentUser.UserId)
                        {
                            // Nobody reactivates themselves (LeavingService.ReactivateAsync refuses it too).
                        }
                        else if (_confirming == (member.UserId, ConfirmKind.Reinstate))
                        {
                            <p role="alert">Reactivate @member.DisplayName in this chapter with @RolesText(member)?</p>
                            <button aria-label="@($"Confirm: reactivate {member.DisplayName}")" @onclick="() => ReactivateAsync(member.UserId)">Reactivate</button>
                            <button aria-label="@($"Cancel reactivating {member.DisplayName}")" @onclick="CancelConfirm" class="btn--secondary">Cancel</button>
                        }
                        else
                        {
                            <button class="btn--secondary" aria-label="@($"Reactivate {member.DisplayName}")" @onclick="() => AskToConfirm(member.UserId, ConfirmKind.Reinstate)">Reactivate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private enum ConfirmKind { StepDown, Reinstate }

    private List<Student> _activeStudents = new();
    private List<LeavingService.StaffMember> _currentStaff = new();
    private List<LeavingService.StaffMember> _steppedDown = new();

    private string? _errorMessage;
    private string? _statusMessage;
    private (int UserId, ConfirmKind Kind)? _confirming;

    private static string RolesText(LeavingService.StaffMember member) =>
        string.Join(", ", member.Roles.Select(r => r.DisplayName()));

    private static IEnumerable<string> History(LeavingService.StaffMember member) =>
        member.History.Select(p =>
            $"Marked Inactive {p.SteppedDownAt:d MMMM yyyy}" + (p.SteppedDownBy is { } by ? $" by {by}" : "")
            + (p.ReinstatedAt is { } back ? $"; reactivated {back:d MMMM yyyy}" + (p.ReinstatedBy is { } who ? $" by {who}" : "") : ""));
    private void AskToConfirm(int userId, ConfirmKind kind)
    {
        _errorMessage = null;
        _statusMessage = null;
        _confirming = (userId, kind);
    }

    private void CancelConfirm() => _confirming = null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Loaded into locals and assigned together: the page renders at its first await.
        var students = await Db.Students
            .Where(s => s.Status == StudentStatus.Active)
            .OrderBy(s => s.Name)
            .ToListAsync();

        // FR-017: Teachers, Admins and Safeguarding Officers of this chapter (docs/adr/0010-chapters.md).
        var staff = await LeavingService.ListStaffAsync();

        _activeStudents = students;
        _currentStaff = staff.Where(m => !m.IsInactive).ToList();
        _steppedDown = staff.Where(m => m.IsInactive).ToList();
    }

    private async Task MarkStudentInactiveAsync(int studentId)
    {
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var student = await LeavingService.MarkStudentInactiveAsync(studentId);
            _statusMessage = $"{student.Name} marked as left (Inactive).";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task MarkInactiveAsync(int userId)
    {
        _confirming = null;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var member = await LeavingService.MarkInactiveAsync(userId);
            _statusMessage = $"{member.DisplayName} is now Inactive in this chapter.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ReactivateAsync(int userId)
    {
        _confirming = null;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var member = await LeavingService.ReactivateAsync(userId);
            _statusMessage = $"{member.DisplayName} is active in this chapter again.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }
}
