@page "/retention/mark-as-left"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Retention
@inject VlmsDbContext Db
@inject LeavingService LeavingService

<PageTitle>Mark as left</PageTitle>

<h1>Mark as left</h1>

<p>
    A manual action for Admins only. It is not inferred from disengagement or activity. Marking a Student or staff member as having left records the
    date automatically (the moment you click the button, not a backdated date you choose) and feeds
    the <a href="/reporting/records-due-for-deletion">records due for deletion</a> retention report.
    This does not delete anything and does not affect promotions, badges, or certificates.
</p>
<p>
    Students, parents and Approvers who leave keep their sign-in. A Teacher, Admin or Safeguarding Officer
    marked as left loses all staff access at once. If they are also a parent they can still sign in, but
    only as a parent of their own children; otherwise they can no longer sign in at all. Their staff
    roles are kept as a record. You can't mark yourself as left, or the last Admin who hasn't left.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<h2>Students</h2>
@if (_activeStudents.Count == 0)
{
    <p>No Active students.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Student</th>
                <th>Enrolment date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in _activeStudents)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.EnrolmentDate.ToString("d MMMM yyyy")</td>
                    <td><button aria-label="@($"Mark {student.Name} as left")" @onclick="() => MarkStudentInactiveAsync(student.Id)">Mark as left</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Staff</h2>
@if (_currentStaff.Count == 0)
{
    <p>No Teachers, Admins or Safeguarding Officers who have not already been marked as left.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in _currentStaff)
            {
                <tr>
                    <td>@member.User.DisplayName</td>
                    <td>@member.User.Email</td>
                    <td>@string.Join(", ", member.Roles.Select(r => r.DisplayName()))</td>
                    <td>
                        @if (_confirmingUserId == member.User.Id)
                        {
                            <p role="alert">Mark @member.User.DisplayName as left? They lose all staff access at once, and you cannot undo this in the app.</p>
                            <button aria-label="@($"Confirm: mark {member.User.DisplayName} as left")" @onclick="() => MarkStaffLeftAsync(member.User.Id)">Confirm</button>
                            <button aria-label="@($"Cancel marking {member.User.DisplayName} as left")" @onclick="CancelConfirm">Cancel</button>
                        }
                        else
                        {
                            <button aria-label="@($"Mark {member.User.DisplayName} as left")" @onclick="() => AskToConfirm(member.User.Id)">Mark as left</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Student> _activeStudents = new();
    private List<StaffRow> _currentStaff = new();

    private sealed record StaffRow(AppUser User, IReadOnlyList<Role> Roles);
    private string? _errorMessage;
    private string? _statusMessage;
    private int? _confirmingUserId;

    private void AskToConfirm(int userId)
    {
        _errorMessage = null;
        _statusMessage = null;
        _confirmingUserId = userId;
    }

    private void CancelConfirm() => _confirmingUserId = null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _activeStudents = await Db.Students
            .Where(s => s.Status == StudentStatus.Active)
            .OrderBy(s => s.Name)
            .ToListAsync();

        // FR-017: Teachers, Admins and Safeguarding Officers (LeftStaffPolicy.StaffRoles).
        var staffRoles = await Db.UserRoles
            .Where(r => r.Role == Role.Teacher || r.Role == Role.Admin || r.Role == Role.SafeguardingOfficer)
            .ToListAsync();
        var rolesByUser = staffRoles.ToLookup(r => r.UserId, r => r.Role);
        var staffUserIds = rolesByUser.Select(g => g.Key).ToList();

        var users = await Db.AppUsers
            .Where(u => staffUserIds.Contains(u.Id) && !u.HasLeft)
            .OrderBy(u => u.DisplayName)
            .ToListAsync();
        _currentStaff = users.Select(u => new StaffRow(u, rolesByUser[u.Id].OrderBy(r => r).ToList())).ToList();
    }

    private async Task MarkStudentInactiveAsync(int studentId)
    {
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var student = await LeavingService.MarkStudentInactiveAsync(studentId);
            _statusMessage = $"{student.Name} marked as left (Inactive).";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task MarkStaffLeftAsync(int userId)
    {
        _confirmingUserId = null;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var member = await LeavingService.MarkStaffLeftAsync(userId);
            _statusMessage = $"{member.DisplayName} marked as left. Their staff access has ended.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }
}
