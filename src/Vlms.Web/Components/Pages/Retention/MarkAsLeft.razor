@page "/retention/mark-as-left"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Retention
@inject VlmsDbContext Db
@inject LeavingService LeavingService
@inject ICurrentUserContext CurrentUser

<PageTitle>Leaving and stepping down</PageTitle>

<PageHeader Title="Leaving and stepping down" />

<p class="intro">
    A manual action for Admins only. It is not inferred from disengagement or activity. Marking a Student as having left, or
    stepping down a staff member, records the date automatically (the moment you click the button, not a backdated date you choose)
    and feeds the <a href="/reporting/records-due-for-deletion">records due for deletion</a> retention report.
    This does not delete anything and does not affect promotions, badges, or certificates.
</p>
<p>
    Students, parents and Approvers who leave keep their sign-in. A Teacher, Admin or Safeguarding Officer
    who steps down loses all staff access at once. If they are also a parent they can still sign in, but
    only as a parent of their own children; otherwise they can no longer sign in at all. Their staff
    roles are kept, and reinstating them restores those roles. You can't step down or reinstate yourself,
    or step down the last Admin.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<h2>Students</h2>
@if (_activeStudents.Count == 0)
{
    <p>No Active students.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Student</th>
                <th>Enrolment date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in _activeStudents)
            {
                <tr>
                    <td data-label="Student">@student.Name</td>
                    <td data-label="Enrolment date">@student.EnrolmentDate.ToString("d MMMM yyyy")</td>
                    <td><button class="btn--secondary" aria-label="@($"Mark {student.Name} as left")" @onclick="() => MarkStudentInactiveAsync(student.Id)">Mark as left</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Staff</h2>
@if (_currentStaff.Count == 0)
{
    <p>No Teachers, Admins or Safeguarding Officers who have not stepped down.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>History</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in _currentStaff)
            {
                <tr>
                    <td data-label="Name">@member.DisplayName</td>
                    <td data-label="Email">@member.Email</td>
                    <td data-label="Roles">@RolesText(member)</td>
                    <td data-label="History">@foreach (var line in History(member)) { <div>@line</div> }</td>
                    <td>
                        @if (_confirming == (member.UserId, ConfirmKind.StepDown))
                        {
                            <p role="alert">Step down @member.DisplayName? They lose all staff access at once.</p>
                            <button class="btn--danger" aria-label="@($"Confirm: step down {member.DisplayName}")" @onclick="() => StepDownAsync(member.UserId)">Step down</button>
                            <button aria-label="@($"Cancel stepping down {member.DisplayName}")" @onclick="CancelConfirm" class="btn--secondary">Cancel</button>
                        }
                        else
                        {
                            <button class="btn--secondary" aria-label="@($"Step down {member.DisplayName}")" @onclick="() => AskToConfirm(member.UserId, ConfirmKind.StepDown)">Step down</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Stepped down</h2>
@if (_steppedDown.Count == 0)
{
    <p>Nobody in this chapter has stepped down.</p>
}
else
{
    <table class="data-table data-table--wide">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>History</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in _steppedDown)
            {
                <tr>
                    <td data-label="Name">@member.DisplayName</td>
                    <td data-label="Email">@member.Email</td>
                    <td data-label="Roles">@RolesText(member)</td>
                    <td data-label="History">@foreach (var line in History(member)) { <div>@line</div> }</td>
                    <td>
                        @if (member.UserId == CurrentUser.UserId)
                        {
                            // Nobody reinstates themselves (LeavingService.ReinstateAsync refuses it too).
                        }
                        else if (_confirming == (member.UserId, ConfirmKind.Reinstate))
                        {
                            <p role="alert">Reinstate @member.DisplayName as @RolesText(member)?</p>
                            <button aria-label="@($"Confirm: reinstate {member.DisplayName}")" @onclick="() => ReinstateAsync(member.UserId)">Reinstate</button>
                            <button aria-label="@($"Cancel reinstating {member.DisplayName}")" @onclick="CancelConfirm" class="btn--secondary">Cancel</button>
                        }
                        else
                        {
                            <button class="btn--secondary" aria-label="@($"Reinstate {member.DisplayName}")" @onclick="() => AskToConfirm(member.UserId, ConfirmKind.Reinstate)">Reinstate</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private enum ConfirmKind { StepDown, Reinstate }

    private List<Student> _activeStudents = new();
    private List<LeavingService.StaffMember> _currentStaff = new();
    private List<LeavingService.StaffMember> _steppedDown = new();

    private string? _errorMessage;
    private string? _statusMessage;
    private (int UserId, ConfirmKind Kind)? _confirming;

    private static string RolesText(LeavingService.StaffMember member) =>
        string.Join(", ", member.Roles.Select(r => r.DisplayName()));

    private static IEnumerable<string> History(LeavingService.StaffMember member) =>
        member.History.Select(p =>
            $"Stepped down {p.SteppedDownAt:d MMMM yyyy}" + (p.SteppedDownBy is { } by ? $" by {by}" : "")
            + (p.ReinstatedAt is { } back ? $"; reinstated {back:d MMMM yyyy}" + (p.ReinstatedBy is { } who ? $" by {who}" : "") : ""));
    private void AskToConfirm(int userId, ConfirmKind kind)
    {
        _errorMessage = null;
        _statusMessage = null;
        _confirming = (userId, kind);
    }

    private void CancelConfirm() => _confirming = null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Loaded into locals and assigned together: the page renders at its first await.
        var students = await Db.Students
            .Where(s => s.Status == StudentStatus.Active)
            .OrderBy(s => s.Name)
            .ToListAsync();

        // FR-017: Teachers, Admins and Safeguarding Officers of this chapter (docs/adr/0010-chapters.md).
        var staff = await LeavingService.ListStaffAsync();

        _activeStudents = students;
        _currentStaff = staff.Where(m => !m.SteppedDown).ToList();
        _steppedDown = staff.Where(m => m.SteppedDown).ToList();
    }

    private async Task MarkStudentInactiveAsync(int studentId)
    {
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var student = await LeavingService.MarkStudentInactiveAsync(studentId);
            _statusMessage = $"{student.Name} marked as left (Inactive).";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task StepDownAsync(int userId)
    {
        _confirming = null;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var member = await LeavingService.StepDownAsync(userId);
            _statusMessage = $"{member.DisplayName} stepped down. Their staff access has ended.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ReinstateAsync(int userId)
    {
        _confirming = null;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            var member = await LeavingService.ReinstateAsync(userId);
            _statusMessage = $"{member.DisplayName} reinstated.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }
}
