@page "/guardianship/accept-invite"
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(WebHardening.AccountFormsPolicy)]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Vlms.Infrastructure.Guardianship
@using Vlms.Infrastructure.Identity
@using Vlms.Web.Components.Account

@inject GuardianInviteService InviteService
@inject SignInManager<VlmsIdentityUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Static SSR, not interactive — same reasoning as Login.razor/Register.razor: signing the new
   guardian in writes the auth cookie, which needs a normal HTTP request/response, not a live
   SignalR circuit. This page is deliberately reachable with no [Authorize] attribute — the caller
   clicking an emailed link is, by definition, not yet signed in (STATE.md "Identity" item 5,
   replacing the former Microsoft Graph guardian-invitation blocker — see
   GuardianInviteService/GuardianInvite's doc comments for the full token design). *@

<PageTitle>@(_mode == GuardianInviteService.AcceptMode.CreateAccount ? "Set up your account" : "Accept your invite")</PageTitle>

<h1>@(_mode == GuardianInviteService.AcceptMode.CreateAccount ? "Set up your account" : "Accept your invite")</h1>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
else if (_accepted)
{
    <p role="status">Invite accepted. Your account is now linked to the guardian record. Once an Admin has approved you as a parent, your children appear on <a href="parent/dashboard">your dashboard</a>.</p>
}
else if (_mode == GuardianInviteService.AcceptMode.SignInRequired)
{
    <p>@GuardianInviteService.SignInToAcceptMessage</p>
    <p><a href="@SignInHref">Sign in to accept</a></p>
}
else if (_mode == GuardianInviteService.AcceptMode.SignedInAsDifferentAccount)
{
    <p class="error" role="alert">@GuardianInviteService.DifferentAccountMessage</p>
}
else if (_mode == GuardianInviteService.AcceptMode.ReadyToLink)
{
    <p>Accept this invite to link your account to the guardian record. An Admin then approves you as a parent.</p>

    <EditForm Model="Input" method="post" OnSubmit="AcceptSignedInAsync" FormName="accept-invite-signed-in">
        <button type="submit">Accept invite</button>
    </EditForm>
}
else
{
    <p>Choose a password to finish setting up your Varangians LMS account.</p>

    <EditForm Model="Input" method="post" OnValidSubmit="AcceptAsync" FormName="accept-invite">
        <input type="hidden" name="Token" value="@Token" />
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <div>
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" aria-required="true" />
        </div>
        <div>
            <label for="confirmPassword">Confirm password</label>
            <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
        </div>

        <button type="submit">Set up account</button>
    </EditForm>
}

@code {
    // No property initializer — BL0008 (learn.microsoft.com/aspnet/core/diagnostics/bl0008): see
    // Login.razor's identical comment.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private string? _errorMessage;
    private bool _accepted;
    private GuardianInviteService.AcceptMode _mode = GuardianInviteService.AcceptMode.CreateAccount;

    // Back to this page, token and all, after sign-in (including the TOTP step: Login.razor passes
    // returnUrl on to LoginWith2fa). IdentityRedirectManager only follows relative URLs.
    private string SignInHref =>
        "Account/Login?ReturnUrl=" + Uri.EscapeDataString("/guardianship/accept-invite?token=" + Uri.EscapeDataString(Token ?? ""));

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (string.IsNullOrEmpty(Token))
        {
            _errorMessage = "This invite link is missing its token.";
            return;
        }

        // functional.md FR-004 (22/10/2026): an invite to an email that already has an account is
        // accepted by signing in to that account, never by the email match alone.
        try
        {
            _mode = await InviteService.GetAcceptModeAsync(Token);
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.Security.Cryptography.CryptographicException)
        {
            _errorMessage = ex is System.Security.Cryptography.CryptographicException
                ? "This invite link is invalid or has expired."
                : ex.Message;
        }
    }

    private async Task AcceptSignedInAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            _errorMessage = "This invite link is missing its token.";
            return;
        }

        try
        {
            await InviteService.AcceptForSignedInUserAsync(Token);
            _accepted = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or System.Security.Cryptography.CryptographicException)
        {
            _errorMessage = ex is System.Security.Cryptography.CryptographicException
                ? "This invite link is invalid or has expired."
                : ex.Message;
        }
    }

    private async Task AcceptAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            _errorMessage = "This invite link is missing its token.";
            return;
        }

        try
        {
            var appUser = await InviteService.AcceptAsync(Token, Input.Password);

            var identityUser = await SignInManager.UserManager.FindByIdAsync(appUser.Id.ToString());
            if (identityUser is null)
            {
                _errorMessage = "Account setup succeeded but signing in automatically failed — please log in.";
                return;
            }

            await SignInManager.SignInAsync(identityUser, isPersistent: false);
            RedirectManager.RedirectTo("/parent/dashboard");
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.Security.Cryptography.CryptographicException)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
