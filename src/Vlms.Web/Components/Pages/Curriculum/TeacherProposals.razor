@page "/curriculum/teacher"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Curriculum
@inject VlmsDbContext Db
@inject ICurrentUserContext CurrentUser
@inject LessonProposalService ProposalService
@inject LessonUploadService Uploads

<PageTitle>Propose a lesson change</PageTitle>

<PageHeader Title="Curriculum: propose a lesson change" />

<p class="intro">
    Any Teacher can propose that a lesson be created, edited, or retired. An Approver then
    approves or rejects the proposal (with comments). A rejected proposal can be revised and
    resubmitted.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<h2>Lessons</h2>
<table class="data-table data-table--wide">
    <thead>
        <tr>
            <th>Rank</th>
            <th>Order</th>
            <th>Code</th>
            <th>Title</th>
            <th>Tags</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lesson in _lessons)
        {
            <tr>
                <td data-label="Rank">@lesson.Rank?.Name</td>
                <td data-label="Order">@lesson.Order</td>
                <td data-label="Code">@lesson.Code</td>
                <td data-label="Title">@lesson.Title</td>
                <td data-label="Tags">@string.Join(", ", lesson.Tags.Select(t => TagLabel(t.Tag)).Order())</td>
                <td data-label="Status">@(lesson.IsActive ? "Active" : "Retired")</td>
                <td>
                    <div class="cell-actions">
                        <button type="button" class="btn--secondary" aria-label="@($"Propose edit to {lesson.Title}")" @onclick="() => StartEdit(lesson)">Propose edit</button>
                        @if (lesson.IsActive)
                        {
                            <button type="button" class="btn--secondary" aria-label="@($"Propose retirement of {lesson.Title}")" @onclick="() => StartRetire(lesson)">Propose retirement</button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="section"><button type="button" @onclick="StartCreate">Propose new lesson</button></p>

@if (_form is not null)
{
    <h2>@_formTitle</h2>
    <EditForm class="form form--wide" Model="_form" OnValidSubmit="SubmitProposalAsync">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        @if (_form.ChangeType == LessonChangeType.Create)
        {
            <div class="field">
                <label for="rank">Rank</label>
                <InputSelect id="rank" @bind-Value="_form.RankId">
                    @foreach (var rank in _ranks)
                    {
                        <option value="@rank.Id">@rank.Name</option>
                    }
                </InputSelect>
            </div>
        }

        <div class="field">
            <label for="code">Code</label>
            <InputText id="code" @bind-Value="_form.Code" disabled="@(_form.ChangeType == LessonChangeType.Retire)" />
        </div>
        <div class="field">
            <label for="title">Title</label>
            <InputText id="title" @bind-Value="_form.Title" disabled="@(_form.ChangeType == LessonChangeType.Retire)" />
        </div>
        @if (_form.ChangeType != LessonChangeType.Retire)
        {
            <div class="field">
                <label for="order">Delivery order within the rank</label>
                <InputNumber id="order" @bind-Value="_form.Order" min="1" />
            </div>
            <fieldset>
                <legend>Tags (at least one)</legend>
                @foreach (var tag in Enum.GetValues<LessonTag>())
                {
                    <label class="check">
                        <input type="checkbox" checked="@_form.Tags.Contains(tag)" @onchange="e => ToggleTag(tag, (bool)e.Value!)" />
                        @TagLabel(tag)
                    </label>
                }
            </fieldset>
            <fieldset>
                <legend>Files</legend>
                @if (_form.Files.Count == 0)
                {
                    <p>No files yet.</p>
                }
                else
                {
                    <ol class="file-list">
                        @for (var i = 0; i < _form.Files.Count; i++)
                        {
                            var index = i;
                            var file = _form.Files[i];
                            var n = i + 1;
                            <li>
                                <span>@file.FileName (@(IsNewUpload(file) ? "new upload" : "current file"))</span>
                                <span class="cell-actions">
                                    <button type="button" class="btn--secondary" disabled="@(index == 0)" @onclick="() => MoveFile(index, -1)">Move file @n up</button>
                                    <button type="button" class="btn--secondary" disabled="@(index == _form.Files.Count - 1)" @onclick="() => MoveFile(index, 1)">Move file @n down</button>
                                    <button type="button" class="btn--secondary" @onclick="() => _form.Files.Remove(file)">Remove file @n</button>
                                </span>
                            </li>
                        }
                    </ol>
                }
                <div class="field">
                    <label for="fileUpload">Upload files</label>
                    <InputFile id="fileUpload" OnChange="OnFilesSelectedAsync" multiple aria-describedby="fileUploadHelp" />
                    <p id="fileUploadHelp">
                        Accepted: @string.Join(", ", LessonUploadService.AllowedExtensions.Order()).
                        Up to @(Uploads.MaxFileBytes / (1024 * 1024)) MB per file.
                        New files go live only when an Approver approves the proposal.
                    </p>
                </div>
            </fieldset>
            <div class="field">
                <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
            </div>
        }

        <div class="form-actions">
            <button type="submit">Submit proposal</button>
            <button type="button" @onclick="CancelForm" class="btn--secondary">Cancel</button>
        </div>
    </EditForm>
}

<h2>My proposals</h2>
<table class="data-table data-table--wide">
    <thead>
        <tr>
            <th>Lesson</th>
            <th>Type</th>
            <th>Status</th>
            <th>Submitted</th>
            <th>Files</th>
            <th>Approver comments</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var proposal in _myProposals)
        {
            <tr>
                <td data-label="Lesson">@(proposal.Lesson?.Title ?? "(new lesson)")</td>
                <td data-label="Type">@proposal.ChangeType</td>
                <td data-label="Status">@proposal.Status</td>
                <td data-label="Submitted">@proposal.SubmittedAt.ToString("g")</td>
                <td data-label="Files">
                    @{
                        var proposalFiles = FilesOfProposal(proposal);
                    }
                    @if (proposalFiles.Count > 0)
                    {
                        <ul>
                            @for (var i = 0; i < proposalFiles.Count; i++)
                            {
                                <li><a href="@ProposalReview.ProposalFileUrl(proposal.Id, i)" target="_blank" rel="noopener">@proposalFiles[i].FileName (opens in a new tab)</a></li>
                            }
                        </ul>
                    }
                </td>
                <td data-label="Approver comments">@proposal.ApprovalComments</td>
                <td>
                    @if (proposal.Status == ProposalStatus.Rejected)
                    {
                        <button type="button" class="btn--secondary" aria-label="@($"Resubmit proposal {proposal.Id}")" @onclick="() => StartResubmit(proposal)">Resubmit</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Lesson> _lessons = new();
    private List<Rank> _ranks = new();
    private List<LessonChangeProposal> _myProposals = new();
    private ProposalFormModel? _form;
    private string _formTitle = "";
    private string? _errorMessage;
    private string? _statusMessage;
    private int? _resubmitOriginalId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _ranks = await Db.Ranks.OrderBy(r => r.Order).ToListAsync();
        _lessons = await Db.Lessons
            .Include(l => l.Rank)
            .Include(l => l.Tags)
            .Include(l => l.Files)
            .OrderBy(l => l.Rank!.Order).ThenBy(l => l.Order).ThenBy(l => l.Code)
            .ToListAsync();

        var userId = CurrentUser.UserId;
        _myProposals = userId is null
            ? new List<LessonChangeProposal>()
            : await Db.LessonChangeProposals
                .Include(p => p.Lesson)
                .Where(p => p.ProposedByUserId == userId)
                .OrderByDescending(p => p.SubmittedAt)
                .ToListAsync();
    }

    private void StartCreate()
    {
        _errorMessage = null;
        _statusMessage = null;
        _resubmitOriginalId = null;
        _formTitle = "Propose a new lesson";
        _form = new ProposalFormModel
        {
            ChangeType = LessonChangeType.Create,
            RankId = _ranks.FirstOrDefault()?.Id ?? 0,
            Order = 1,
            IsActive = true
        };
    }

    private void StartEdit(Lesson lesson)
    {
        _errorMessage = null;
        _statusMessage = null;
        _resubmitOriginalId = null;
        _formTitle = $"Propose an edit to {lesson.Title}";
        _form = new ProposalFormModel
        {
            ChangeType = LessonChangeType.Edit,
            LessonId = lesson.Id,
            RankId = lesson.RankId,
            Code = lesson.Code,
            Title = lesson.Title,
            Order = lesson.Order,
            Tags = lesson.Tags.Select(t => t.Tag).ToHashSet(),
            Files = FilesOf(lesson),
            IsActive = lesson.IsActive
        };
    }

    private void StartRetire(Lesson lesson)
    {
        _errorMessage = null;
        _statusMessage = null;
        _resubmitOriginalId = null;
        _formTitle = $"Propose retiring {lesson.Title}";
        _form = new ProposalFormModel
        {
            ChangeType = LessonChangeType.Retire,
            LessonId = lesson.Id,
            RankId = lesson.RankId,
            Code = lesson.Code,
            Title = lesson.Title,
            Order = lesson.Order,
            Tags = lesson.Tags.Select(t => t.Tag).ToHashSet(),
            Files = FilesOf(lesson),
            IsActive = false
        };
    }

    private void StartResubmit(LessonChangeProposal proposal)
    {
        _errorMessage = null;
        _statusMessage = null;
        _resubmitOriginalId = proposal.Id;
        _formTitle = "Resubmit proposal";
        var content = JsonSerializer.Deserialize<ProposedLessonContent>(proposal.ProposedContent)
            ?? throw new InvalidOperationException("ProposedContent could not be parsed.");
        _form = new ProposalFormModel
        {
            ChangeType = proposal.ChangeType,
            LessonId = proposal.LessonId,
            RankId = content.RankId ?? 0,
            Code = content.Code,
            Title = content.Title,
            Order = content.Order,
            Tags = content.Tags.ToHashSet(),
            Files = content.Files.Select(f => new FileFormModel { FileName = f.FileName, BlobKey = f.BlobKey }).ToList(),
            IsActive = content.IsActive
        };
    }

    private static List<FileFormModel> FilesOf(Lesson lesson) =>
        lesson.Files.OrderBy(f => f.Order)
            .Select(f => new FileFormModel { FileName = f.FileName, BlobKey = f.BlobKey })
            .ToList();

    private const int MaxFilesPerSelection = 10;

    private static IReadOnlyList<ProposedLessonFile> FilesOfProposal(LessonChangeProposal proposal)
    {
        try
        {
            return JsonSerializer.Deserialize<ProposedLessonContent>(proposal.ProposedContent)?.Files ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static bool IsNewUpload(FileFormModel file) =>
        file.BlobKey.StartsWith(PendingKeys.Prefix, StringComparison.Ordinal);

    private void MoveFile(int index, int direction)
    {
        var target = index + direction;
        if (_form is null || target < 0 || target >= _form.Files.Count)
        {
            return;
        }

        (_form.Files[index], _form.Files[target]) = (_form.Files[target], _form.Files[index]);
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_form is null)
        {
            return;
        }

        _errorMessage = null;
        _statusMessage = null;
        var uploaded = 0;
        try
        {
            foreach (var browserFile in e.GetMultipleFiles(MaxFilesPerSelection))
            {
                await using var stream = browserFile.OpenReadStream(Uploads.MaxFileBytes);
                var file = await Uploads.UploadAsync(browserFile.Name, browserFile.ContentType, stream);
                _form.Files.Add(new FileFormModel { FileName = file.FileName, BlobKey = file.BlobKey });
                uploaded++;
            }
        }
        catch (IOException)
        {
            _errorMessage = $"A file is larger than the {Uploads.MaxFileBytes / (1024 * 1024)} MB limit.";
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }

        if (uploaded > 0)
        {
            _statusMessage = uploaded == 1 ? "1 file uploaded." : $"{uploaded} files uploaded.";
        }
    }

    private void ToggleTag(LessonTag tag, bool selected)
    {
        if (selected)
        {
            _form?.Tags.Add(tag);
        }
        else
        {
            _form?.Tags.Remove(tag);
        }
    }

    private static string TagLabel(LessonTag tag) => tag switch
    {
        LessonTag.ChurchLife => "Church Life",
        LessonTag.ChurchInterior => "Church Interior",
        LessonTag.ChurchHistory => "Church History",
        LessonTag.OldTestament => "Old Testament",
        LessonTag.NewTestament => "New Testament",
        LessonTag.ChurchYear => "Church Year",
        LessonTag.ChristianLife => "Christian Life",
        _ => tag.ToString()
    };

    private void CancelForm()
    {
        _form = null;
        _resubmitOriginalId = null;
        _errorMessage = null;
        _statusMessage = null;
    }

    private async Task SubmitProposalAsync()
    {
        if (_form is null)
        {
            return;
        }

        _errorMessage = null;
        _statusMessage = null;

        var content = new ProposedLessonContent
        {
            RankId = _form.ChangeType == LessonChangeType.Create ? _form.RankId : null,
            Code = _form.Code,
            Title = _form.Title,
            Order = _form.Order,
            Tags = _form.Tags.Order().ToList(),
            Files = _form.Files.Select(f => new ProposedLessonFile { FileName = f.FileName.Trim(), BlobKey = f.BlobKey.Trim() }).ToList(),
            IsActive = _form.ChangeType == LessonChangeType.Retire ? false : _form.IsActive
        };

        var wasResubmit = _resubmitOriginalId is not null;

        try
        {
            if (_resubmitOriginalId is int originalId)
            {
                await ProposalService.ResubmitAsync(originalId, content);
            }
            else
            {
                await ProposalService.ProposeAsync(_form.LessonId, _form.ChangeType, content);
            }

            _form = null;
            _resubmitOriginalId = null;
            _statusMessage = wasResubmit ? "Proposal resubmitted for approval." : "Proposal submitted for approval.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Mutable form-binding model — deliberately separate from
    /// <see cref="ProposedLessonContent"/>, whose <c>required</c>/init-only members don't suit
    /// EditForm two-way binding.
    /// </summary>
    private sealed class ProposalFormModel
    {
        public LessonChangeType ChangeType { get; set; }
        public int? LessonId { get; set; }
        public int RankId { get; set; }

        [Required]
        public string Code { get; set; } = "";

        [Required]
        public string Title { get; set; } = "";

        [Range(1, int.MaxValue)]
        public int Order { get; set; } = 1;

        public HashSet<LessonTag> Tags { get; set; } = new();
        public List<FileFormModel> Files { get; set; } = new();

        public bool IsActive { get; set; } = true;
    }

    private sealed class FileFormModel
    {
        public string FileName { get; set; } = "";
        public string BlobKey { get; set; } = "";
    }
}
