@page "/curriculum/approver"
@attribute [Authorize(Policy = "RequireApprover")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Curriculum
@inject VlmsDbContext Db
@inject LessonProposalService ProposalService

<PageTitle>Curriculum approvals</PageTitle>

<h1>Curriculum: pending proposals</h1>

<p>
    The Approver role decides curriculum proposals only — it has no consent, DBS, or safeguarding
    access. Differences from the current lesson are marked "Changed", "Added" or "Removed".
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

@if (_reviews.Count == 0)
{
    <p>No proposals are waiting for a decision.</p>
}

@foreach (var review in _reviews)
{
    <section aria-labelledby="proposal@(review.ProposalId)">
        <h2 id="proposal@(review.ProposalId)">@review.ChangeType: @TitleOf(review)</h2>
        <p>Proposed by @review.ProposedBy on @review.SubmittedAt.ToString("g").</p>

        <table>
            <caption>@(review.HasCurrent ? "Current lesson compared with the proposal" : "New lesson")</caption>
            <thead>
                <tr>
                    <th scope="col">Field</th>
                    @if (review.HasCurrent)
                    {
                        <th scope="col">Current</th>
                    }
                    <th scope="col">Proposed</th>
                    @if (review.HasCurrent)
                    {
                        <th scope="col">Difference</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var field in review.Fields)
                {
                    <tr class="@(field.Changed && review.HasCurrent ? "review-changed" : null)">
                        <th scope="row">@field.Label</th>
                        @if (review.HasCurrent)
                        {
                            <td>@field.Current</td>
                        }
                        <td>@field.Proposed</td>
                        @if (review.HasCurrent)
                        {
                            <td>@(field.Changed ? "Changed" : "Same")</td>
                        }
                    </tr>
                }
                <tr class="@(review.HasCurrent && (review.FilesChanged || review.FileOrderChanged) ? "review-changed" : null)">
                    <th scope="row">Files</th>
                    @if (review.HasCurrent)
                    {
                        <td>@FileList(review.CurrentFiles)</td>
                    }
                    <td>@FileList(review.ProposedFiles)</td>
                    @if (review.HasCurrent)
                    {
                        <td>@FilesVerdict(review)</td>
                    }
                </tr>
            </tbody>
        </table>

        <div>
            <button type="button" @onclick="() => ApproveAsync(review.ProposalId)">Approve proposal @review.ProposalId</button>
        </div>
        <div>
            <label for="comments@(review.ProposalId)">Rejection comments for proposal @review.ProposalId</label>
            <input type="text" id="comments@(review.ProposalId)"
                   value="@GetComments(review.ProposalId)"
                   @oninput="e => SetComments(review.ProposalId, e.Value?.ToString())" />
            <button type="button" @onclick="() => RejectAsync(review.ProposalId)">Reject proposal @review.ProposalId</button>
        </div>
    </section>
}

@code {
    private List<ProposalReview> _reviews = new();
    private readonly Dictionary<int, string> _comments = new();
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var ids = await Db.LessonChangeProposals
            .Where(p => p.Status == ProposalStatus.Pending)
            .OrderBy(p => p.SubmittedAt)
            .Select(p => p.Id)
            .ToListAsync();

        _reviews = new List<ProposalReview>();
        foreach (var id in ids)
        {
            _reviews.Add(await ProposalService.GetReviewAsync(id));
        }
    }

    private static string TitleOf(ProposalReview review)
    {
        var title = review.Fields.First(f => f.Label == "Title");
        return title.Current ?? title.Proposed;
    }

    private static RenderFragment FileList(IReadOnlyList<ReviewFile> files) => builder =>
    {
        if (files.Count == 0)
        {
            builder.AddContent(0, "No files");
            return;
        }

        builder.OpenElement(1, "ol");
        foreach (var file in files)
        {
            builder.OpenElement(2, "li");
            if (file.Change == ReviewFileChange.Removed)
            {
                builder.AddAttribute(3, "class", "review-removed");
            }

            builder.OpenElement(4, "a");
            builder.AddAttribute(5, "href", file.Url);
            builder.AddAttribute(6, "target", "_blank");
            builder.AddAttribute(7, "rel", "noopener");
            builder.AddContent(8, $"{file.FileName} (opens in a new tab)");
            builder.CloseElement();
            if (file.Change != ReviewFileChange.Unchanged)
            {
                builder.AddContent(9, $" [{file.Change}]");
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string FilesVerdict(ProposalReview review) =>
        review.FilesChanged ? "Changed" : review.FileOrderChanged ? "Changed (order)" : "Same";

    private string GetComments(int proposalId) => _comments.TryGetValue(proposalId, out var c) ? c : "";

    private void SetComments(int proposalId, string? value) => _comments[proposalId] = value ?? "";

    private async Task ApproveAsync(int proposalId)
    {
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            await ProposalService.ApproveAsync(proposalId);
            _comments.Remove(proposalId);
            _statusMessage = "Proposal approved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task RejectAsync(int proposalId)
    {
        _errorMessage = null;
        _statusMessage = null;
        var comments = GetComments(proposalId);
        if (string.IsNullOrWhiteSpace(comments))
        {
            _errorMessage = "Rejection comments are required.";
            return;
        }

        try
        {
            await ProposalService.RejectAsync(proposalId, comments);
            _comments.Remove(proposalId);
            _statusMessage = "Proposal rejected.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }
}
