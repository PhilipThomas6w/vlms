@using Vlms.Infrastructure.Safeguarding
@inject ConsentRecordService ConsentService

@if (_pending > 0)
{
    <p role="status" id="pending-consent-notice">
        <a href="/safeguarding/consent">@_pending consent @(_pending == 1 ? "form is" : "forms are") waiting for review</a>
    </p>
}

@code {
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pending = await ConsentService.CountPendingAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _pending = 0; // The home page must still load; the consent page shows the same list.
        }
    }
}
