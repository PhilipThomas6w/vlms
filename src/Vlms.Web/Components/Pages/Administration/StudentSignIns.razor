@page "/administration/student-sign-ins"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@using Vlms.Infrastructure.Identity
@inject StudentAccountService StudentAccounts

<PageTitle>Student sign-ins</PageTitle>

<PageHeader Title="Student sign-ins" />

<p class="intro">
    Students whose parent has created a sign-in for them. An Admin can reset a student's
    password, and turn a sign-in off or back on, here; only a linked parent can create a sign-in.
    Turning a sign-in off signs the student out on every device. A parent's password reset does not
    turn it back on. A student leaving does not turn it off.
</p>
<p>@StudentSignInPolicy.PasswordRuleDescription A reset also clears a lockout.</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
<p role="status">@_statusMessage</p>

@if (_students is null)
{
    <p>Loading…</p>
}
else if (_students.Count == 0)
{
    <p>No student has a sign-in yet.</p>
}
else
{
    <table class="data-table data-table--wide">
        <caption>Students with a sign-in</caption>
        <thead>
            <tr>
                <th scope="col">Student</th>
                <th scope="col">Username</th>
                <th scope="col">Status</th>
                <th scope="col">Reset password</th>
                <th scope="col">Sign-in</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in _students)
            {
                <tr>
                    <th scope="row" data-label="Student">@student.StudentName</th>
                    <td data-label="Username">@student.Username</td>
                    <td data-label="Status">@(student.SignInDisabled ? "Turned off" : "Active")</td>
                    <td data-label="Reset password">
                        <label for="password@(student.StudentId)">New password for @student.StudentName</label>
                        <input type="password" id="password@(student.StudentId)" @bind="_passwords[student.StudentId]" autocomplete="new-password" />
                        <button type="button" aria-label="@($"Reset password for {student.StudentName}")" @onclick="() => ResetAsync(student)">Reset password</button>
                    </td>
                    <td data-label="Sign-in">
                        @if (student.SignInDisabled)
                        {
                            <button type="button" aria-label="@($"Turn on sign-in for {student.StudentName}")" @onclick="() => SetDisabledAsync(student, false)">Turn on</button>
                        }
                        else
                        {
                            <button type="button" aria-label="@($"Turn off sign-in for {student.StudentName}")" @onclick="() => SetDisabledAsync(student, true)">Turn off</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<StudentSignInSummary>? _students;
    private readonly Dictionary<int, string> _passwords = new();
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _students = await StudentAccounts.ListWithSignInAsync();
            _passwords.Clear();
            foreach (var student in _students)
            {
                _passwords[student.StudentId] = "";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            _students = [];
            _errorMessage = ex.Message;
        }
    }

    private async Task ResetAsync(StudentSignInSummary student)
    {
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            var result = await StudentAccounts.ResetPasswordAsync(student.StudentId, _passwords[student.StudentId]);
            if (result.Succeeded)
            {
                _statusMessage = $"Password reset for {student.StudentName}.";
                await LoadAsync();
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors);
            }
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task SetDisabledAsync(StudentSignInSummary student, bool disabled)
    {
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            if (disabled)
            {
                await StudentAccounts.DisableSignInAsync(student.StudentId);
                _statusMessage = $"Sign-in turned off for {student.StudentName}. They are signed out on every device within 30 minutes.";
            }
            else
            {
                await StudentAccounts.RestoreSignInAsync(student.StudentId);
                _statusMessage = $"Sign-in turned back on for {student.StudentName}.";
            }

            await LoadAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }
}
