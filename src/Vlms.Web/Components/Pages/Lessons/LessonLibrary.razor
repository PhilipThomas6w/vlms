@page "/lessons"
@attribute [Authorize(Policy = "RequireLessonLibrary")]
@using Vlms.Infrastructure.Curriculum
@inject LessonLibraryService Library

<PageTitle>Lesson library</PageTitle>

<PageHeader Title="Lesson library" />

<p class="intro">Every active lesson, rank by rank, in the order it is taught. PDFs and images open in your browser; other files, such as Word documents, download.</p>

@* Shown by wwwroot/offline-lessons.js on an iPhone or iPad outside the home-screen app, where saving is offered only once the app is added. *@
<p data-offline-home-screen hidden><a href="/add-to-home-screen.html" data-enhance-nav="false">To keep saved lessons, add this app to your home screen</a></p>

@foreach (var (rank, rankPosition) in _ranks.Select((r, i) => (r, i)))
{
    <section>
        <h2 class="rank-heading">
            <RankMedallion RankId="rank.RankId" Order="rank.Order" RankName="@rank.Name" HasBadgeImage="rank.HasBadgeImage" Size="sm" Alt="" />
            <span>@rank.Name</span>
        </h2>
        @if (rank.Lessons.Count == 0)
        {
            <p>No lessons yet</p>
        }
        else
        {
            <table class="data-table lesson-table">
                <colgroup>
                    <col class="lesson-table__code" />
                    <col class="lesson-table__title" />
                    <col class="lesson-table__tags" />
                    <col class="lesson-table__files" />
                </colgroup>
                <caption>Lessons in @rank.Name</caption>
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Title</th>
                        <th scope="col">Tags</th>
                        <th scope="col">Files</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (lesson, position) in rank.Lessons.Select((l, i) => (l, i)))
                    {
                        @* Anchored by lesson code so the student page and the lesson page can link to a lesson. *@
                        <tr id="lesson-@lesson.Code">
                            <td data-label="Code">@lesson.Code</td>
                            <td data-label="Title">
                                @if (lesson.HasPage)
                                {
                                    <a href="/lessons/@Uri.EscapeDataString(lesson.Code)">@lesson.Title</a>
                                }
                                else
                                {
                                    @lesson.Title
                                }
                            </td>
                            <td data-label="Tags">@string.Join(", ", lesson.Tags)</td>
                            <td data-label="Files">
                                @if (lesson.Files.Count == 0 && !lesson.HasPage)
                                {
                                    <text>No files</text>
                                }
                                else
                                {
                                    @if (lesson.Files.Count > 0)
                                    {
                                        <ul>
                                            @foreach (var file in lesson.Files)
                                            {
                                                <li><a href="/lessons/files/@file.Id" data-enhance-nav="false">@file.DisplayName</a></li>
                                            }
                                        </ul>
                                    }
                                    <SaveLessonButton Id="lesson.Id" Code="@lesson.Code" Title="@lesson.Title" Rank="@rank.Name"
                                                      RankPosition="rankPosition" Position="position" Files="lesson.Files"
                                                      PictureIds="@(lesson.HasPage ? lesson.PictureIds : null)" Version="@lesson.ContentVersion" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private IReadOnlyList<LibraryRank> _ranks = [];

    protected override async Task OnInitializedAsync()
    {
        _ranks = await Library.GetLibraryAsync();
    }
}
