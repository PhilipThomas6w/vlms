@page "/reporting"
@attribute [Authorize(Policy = "RequireAdmin")]
@rendermode InteractiveServer
@using Vlms.Infrastructure.Reporting
@inject ProgressReportingService ReportingService

<PageTitle>Reporting</PageTitle>

<PageHeader Title="Reporting" />

<p class="intro">
    Core progress reports, and flags for students who may be at risk of disengaging.
    Admin only.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
else if (_stats is null)
{
    <p>Loading…</p>
}
else
{
    <h2>Students by rank</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Active students</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rank in _stats.StudentsByRank)
            {
                <tr>
                    <td data-label="Rank">@rank.RankName</td>
                    <td data-label="Active students">@rank.ActiveStudentCount</td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Students by status</h2>
    <dl class="facts">
        <dt>Active</dt><dd>@_stats.StatusCounts.ActiveCount</dd>
        <dt>Inactive</dt><dd>@_stats.StatusCounts.InactiveCount</dd>
        <dt>Graduated</dt><dd>@_stats.StatusCounts.GraduatedCount</dd>
    </dl>

    <h2>Completion stats</h2>
    <p>Total lesson completions recorded (non-reversed): @_stats.TotalLessonCompletions</p>

    <h2>Promotion history</h2>
    @if (_stats.PromotionHistory.Count == 0)
    {
        <p>No promotions recorded yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Rank completed</th>
                    <th>Completed at</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _stats.PromotionHistory)
                {
                    <tr>
                        <td data-label="Student">@entry.StudentName</td>
                        <td data-label="Rank completed">@entry.RankName</td>
                        <td data-label="Completed at">@entry.CompletedAt.ToString("d MMMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>At-risk / disengaged students</h2>
    <p>
        No non-reversed lesson completion in @AtRiskStudentFlagging.AtRiskThresholdDays days, or absent
        from the last @AtRiskStudentFlagging.ConsecutiveAbsenceThreshold meetings in a row — the same
        disengagement flag that the daily check raises, shown here on demand.
    </p>
    @if (_atRiskStudents.Count == 0)
    {
        <p>No students are currently flagged as at risk.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Last activity</th>
                    <th>Days since</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flag in _atRiskStudents)
                {
                    <tr>
                        <td data-label="Student">@flag.StudentName</td>
                        <td data-label="Last activity">@flag.LastActivityAt.ToString("d MMMM yyyy")</td>
                        <td data-label="Days since">@flag.DaysSinceLastActivity</td>
                        <td data-label="Reason">@AtRiskReason(flag)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Records due for deletion</h2>
    <p>
        Retention (UK GDPR): see <a href="/reporting/records-due-for-deletion">the separate "records
        due for deletion" report</a>.
    </p>
}

@code {
    private ProgressStatsReport? _stats;
    private List<AtRiskStudentFlag> _atRiskStudents = new();
    private string? _errorMessage;

    private static string AtRiskReason(AtRiskStudentFlag flag) => (flag.NoRecentCompletion, flag.AbsentFromLastMeetings) switch
    {
        (true, true) => "No recent completion; absent from the last two meetings",
        (false, true) => "Absent from the last two meetings",
        _ => "No recent completion",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await ReportingService.GetProgressStatsAsync();
            _atRiskStudents = (await ReportingService.GetAtRiskStudentsAsync()).ToList();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
