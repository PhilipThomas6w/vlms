@page "/attendance/{EventId:int}/{RankId:int}"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode InteractiveServer
@using Vlms.Infrastructure.Attendance
@inject AttendanceService Attendance
@inject AttendanceNotificationService AttendanceNotifications

@* One class's register at one meeting day (docs/design/chapters-and-attendance.md; the calendar
   requirement): present or absent only, taken or updated by any Teacher in the chapter, opened from
   the event. AttendanceService decides who is on it; the chapter query filter keeps it to this chapter. *@

<PageTitle>Register – Varangians</PageTitle>

<div class="register">
    <PageHeader Title="@(_view is null ? "Register" : $"{_view.RankName} register")">
        <Lead>@(_view is null ? "" : $"{_view.EventTitle}, {_view.MeetingDate:dddd d MMMM yyyy}. ")Tick everyone who is here. Anyone not ticked is marked absent.</Lead>
        <Actions>
            <a class="btn btn--secondary" href="/calendar/events/@EventId">All registers for this day</a>
        </Actions>
    </PageHeader>

    @if (_errorMessage is not null)
    {
        <Notice Kind="danger" Role="alert"><p>@_errorMessage</p></Notice>
    }

    @if (_saved is not null)
    {
        <div tabindex="-1" @ref="_savedElement" class="register__saved">
            <Notice Kind="success" Role="status">
                <p><strong>Register saved: @_saved.Present present, @_saved.Absent absent.</strong></p>
                @if (_saved.PresentWithoutConsent.Count > 0)
                {
                    <p>The Safeguarding Officer has been told that @(_saved.PresentWithoutConsent.Count == 1 ? "a child" : "children") without consent in force attended.</p>
                }
                <p><a href="/progress/record?date=@_view!.MeetingDate.ToString("yyyy-MM-dd")">Record the lessons completed at this meeting</a></p>
            </Notice>
        </div>
    }

    @if (_notFound)
    {
        <div class="empty"><p>That register is not in this chapter's calendar. <a href="/calendar">Back to the calendar</a></p></div>
    }
    else if (_view is null)
    {
        <p class="muted" role="status">Loading the register…</p>
    }
    else
    {
        <p class="register__status">
            @if (_view.Taken)
            {
                <span>Taken by @_view.TakenByName, @_view.TakenAt?.ToLocalTime().ToString("d MMMM yyyy 'at' HH:mm"). Changes are saved over it.</span>
            }
            else
            {
                <span>Not taken yet.</span>
            }
        </p>

        @if (_view.Students.Count == 0)
        {
            <div class="empty"><p>No active students in this class.</p></div>
        }
        else
        {
            <fieldset class="register__students">
                <legend>Here at the meeting (@_present.Count of @_view.Students.Count)</legend>
                <div class="register__tools">
                    <button type="button" class="btn--secondary" @onclick="MarkEveryonePresent">Mark everyone present</button>
                    <button type="button" class="btn--secondary" @onclick="() => _present.Clear()" disabled="@(_present.Count == 0)">Clear the ticks</button>
                </div>
                <ul class="student-rows">
                    @foreach (var student in _view.Students)
                    {
                        <li class="student-row rank-@student.RankOrder @(student.ConsentInForce ? null : "is-blocked")">
                            <input type="checkbox" id="present@(student.StudentId)"
                                   checked="@_present.Contains(student.StudentId)"
                                   aria-describedby="@(student.ConsentInForce ? null : $"present{student.StudentId}-consent")"
                                   @onchange="e => Toggle(student.StudentId, (bool)(e.Value ?? false))" />
                            <label for="present@(student.StudentId)">
                                <span class="student-row__name">@student.StudentName</span>
                                <RankPill Order="student.RankOrder" Name="@student.RankName" />
                            </label>
                            @if (!student.ConsentInForce)
                            {
                                <span class="student-row__state" id="present@(student.StudentId)-consent">
                                    <span class="pill pill--warning"><Icon Name="alert" /> No consent in force</span>
                                    <span class="student-row__reason">They can be marked present, but lessons can't be recorded and the Safeguarding Officer will be told.</span>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </fieldset>

            <section class="register__bar" aria-labelledby="save-register">
                <h2 id="save-register" class="visually-hidden">Save the register</h2>
                <p class="register__count">@_present.Count present, @(_view.Students.Count - _present.Count) absent</p>
                <button type="button" @onclick="SaveAsync" disabled="@_busy">
                    <Icon Name="calendar" /> @(_busy ? "Saving…" : _view.Taken ? "Save changes to the register" : "Save the register")
                </button>
            </section>
        }

    }
</div>

@code {
    [Parameter] public int EventId { get; set; }
    [Parameter] public int RankId { get; set; }

    private RegisterView? _view;
    private bool _notFound;
    private HashSet<int> _present = new();
    private RegisterSaveResult? _saved;
    private ElementReference _savedElement;
    private bool _focusSaved;
    private bool _busy;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSaved)
        {
            _focusSaved = false;
            await _savedElement.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _errorMessage = null;
        _saved = null;
        try
        {
            _view = await Attendance.GetRegisterAsync(EventId, RankId);
            _notFound = _view is null;
            _present = _view?.Students.Where(s => s.Present == true).Select(s => s.StudentId).ToHashSet() ?? [];
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void MarkEveryonePresent()
    {
        foreach (var student in _view!.Students) _present.Add(student.StudentId);
    }

    private void Toggle(int studentId, bool on)
    {
        if (on) { _present.Add(studentId); } else { _present.Remove(studentId); }
    }

    private async Task SaveAsync()
    {
        if (_view is null)
        {
            return;
        }

        _busy = true;
        _errorMessage = null;
        try
        {
            var marks = _view.Students.ToDictionary(s => s.StudentId, s => _present.Contains(s.StudentId));
            var result = await Attendance.SaveRegisterAsync(EventId, RankId, marks);
            await AttendanceNotifications.NotifyPresentWithoutConsentAsync(_view.MeetingDate, result.PresentWithoutConsent);
            await LoadAsync();
            _saved = result;
            _focusSaved = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
