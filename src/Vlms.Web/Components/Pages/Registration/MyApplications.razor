@page "/registration/my-applications"
@attribute [Authorize(Policy = "RequireSignedIn")]
@using System.Globalization
@using Vlms.Domain
@using Vlms.Infrastructure.Registration
@inject StudentApplicationService Applications

@* Static SSR, like Apply.razor. The applicant's own applications only (the service filters by the
   signed-in account, and the restricted details pass the query filter for the applicant alone).
   ?edit={id} opens the answer-and-resubmit form for an application waiting for more information. *@

<PageTitle>My applications</PageTitle>

<PageHeader Title="My applications" />

<FormErrorSummary Errors="_errors" />

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

@if (_editing is { } editing)
{
    <section class="panel section" aria-labelledby="resubmitHeading">
        <h2 id="resubmitHeading">Answer and resubmit: @editing.ChildName</h2>
        <p>The Safeguarding Officer asked:</p>
        <blockquote class="preserve-lines">@editing.Details?.InformationRequest</blockquote>
        <p>Answer the question below and correct anything else on the application, then resubmit it.</p>

        <EditForm class="form" Model="Input" method="post" OnSubmit="ResubmitAsync" FormName="resubmit-application">
            <div class="field">
                <label for="response">Your answer</label>
                <textarea id="response" rows="5" maxlength="4000" name="Input.Response" aria-required="true" aria-invalid="@_errors.Invalid("response")" aria-describedby="@_errors.DescribedBy("response")">@Input.Response</textarea>
                @if (_errors.For("response") is { } responseError)
                {
                    <p class="field-error" id="response-error">@responseError</p>
                }
            </div>

            <h3>Your details</h3>
            <div class="field">
                <label for="phone">Your phone number</label>
                <input id="phone" type="tel" autocomplete="tel" name="Input.Phone" value="@Input.Phone" aria-required="true" aria-invalid="@_errors.Invalid("phone")" aria-describedby="@_errors.DescribedBy("phone")" />
                @if (_errors.For("phone") is { } phoneError)
                {
                    <p class="field-error" id="phone-error">@phoneError</p>
                }
            </div>
            <div class="field">
                <label for="postalAddress">Your postal address</label>
                <textarea id="postalAddress" rows="4" autocomplete="street-address" name="Input.PostalAddress" aria-required="true" aria-invalid="@_errors.Invalid("postalAddress")" aria-describedby="@_errors.DescribedBy("postalAddress")">@Input.PostalAddress</textarea>
                @if (_errors.For("postalAddress") is { } postalAddressError)
                {
                    <p class="field-error" id="postalAddress-error">@postalAddressError</p>
                }
            </div>

            <h3>About the child</h3>
            <div class="field">
                <label for="childName">Child's full name</label>
                <input id="childName" name="Input.Name" value="@Input.Name" autocomplete="off" aria-required="true" aria-invalid="@_errors.Invalid("childName")" aria-describedby="@_errors.DescribedBy("childName")" />
                @if (_errors.For("childName") is { } childNameError)
                {
                    <p class="field-error" id="childName-error">@childNameError</p>
                }
            </div>
            <div class="field">
                <label for="childDateOfBirth">Child's date of birth</label>
                <input id="childDateOfBirth" type="date" name="Input.DateOfBirth" value="@Input.DateOfBirth" aria-required="true" aria-invalid="@_errors.Invalid("childDateOfBirth")" aria-describedby="@_errors.DescribedBy("childDateOfBirth")" />
                @if (_errors.For("childDateOfBirth") is { } childDateOfBirthError)
                {
                    <p class="field-error" id="childDateOfBirth-error">@childDateOfBirthError</p>
                }
            </div>
            <div class="field">
                <label for="relationship">Your relationship to the child</label>
                <input id="relationship" name="Input.Relationship" value="@Input.Relationship" aria-required="true" aria-invalid="@_errors.Invalid("relationship")" aria-describedby="@_errors.DescribedBy("relationship")" />
                @if (_errors.For("relationship") is { } relationshipError)
                {
                    <p class="field-error" id="relationship-error">@relationshipError</p>
                }
            </div>

            <h3>Consent</h3>
            <div class="field--check">
                <InputCheckbox id="photo" @bind-Value="Input.PhotoMediaConsent" />
                <label for="photo">I consent to photos and media of my child</label>
            </div>
            <div class="field--check">
                <InputCheckbox id="transport" @bind-Value="Input.TransportConsent" />
                <label for="transport">I consent to my child being transported between our sites (this can be a short trip)</label>
            </div>
            <div class="field--check">
                <InputCheckbox id="offsite" @bind-Value="Input.OffsiteTripConsent" />
                <label for="offsite">I consent to my child going on off-site trips and outings</label>
            </div>
            <div class="field--check">
                <InputCheckbox id="dataSharing" @bind-Value="Input.DataSharingConsent" />
                <label for="dataSharing">I consent to data sharing</label>
            </div>

            <h3>Medical, dietary and emergency details</h3>
            <div class="field">
                <label for="emergencyContact">Emergency contact (name and phone number)</label>
                <input id="emergencyContact" name="Input.EmergencyContact" value="@Input.EmergencyContact" aria-required="true" aria-invalid="@_errors.Invalid("emergencyContact")" aria-describedby="@_errors.DescribedBy("emergencyContact")" />
                @if (_errors.For("emergencyContact") is { } emergencyContactError)
                {
                    <p class="field-error" id="emergencyContact-error">@emergencyContactError</p>
                }
            </div>
            <div class="field">
                <label for="medical">Emergency medical information (optional)</label>
                <textarea id="medical" rows="3" maxlength="4000" name="Input.EmergencyMedicalInfo" aria-invalid="@_errors.Invalid("medical")" aria-describedby="@_errors.DescribedBy("medical")">@Input.EmergencyMedicalInfo</textarea>
                @if (_errors.For("medical") is { } medicalError)
                {
                    <p class="field-error" id="medical-error">@medicalError</p>
                }
            </div>
            <div class="field">
                <label for="dietary">Dietary requirements, including allergies (optional)</label>
                <textarea id="dietary" rows="4" maxlength="4000" name="Input.DietaryRequirements" aria-invalid="@_errors.Invalid("dietary")" aria-describedby="@_errors.DescribedBy("dietary")">@Input.DietaryRequirements</textarea>
                @if (_errors.For("dietary") is { } dietaryError)
                {
                    <p class="field-error" id="dietary-error">@dietaryError</p>
                }
            </div>
            <div class="field">
                <label for="sen">Special educational needs (optional)</label>
                <textarea id="sen" rows="4" maxlength="4000" name="Input.SpecialEducationalNeeds" aria-invalid="@_errors.Invalid("sen")" aria-describedby="@_errors.DescribedBy("sen")">@Input.SpecialEducationalNeeds</textarea>
                @if (_errors.For("sen") is { } senError)
                {
                    <p class="field-error" id="sen-error">@senError</p>
                }
            </div>

            <div class="form-actions">
                <button type="submit">Resubmit application</button>
                <a class="btn btn--secondary" href="/registration/my-applications">Cancel</a>
            </div>
        </EditForm>
    </section>
}

@if (_applications.Count == 0 && _errorMessage is null)
{
    <p>You have not applied to register a child yet. <a href="/registration/apply">Register a child</a>.</p>
}

@foreach (var application in _applications)
{
    <section class="panel application" aria-labelledby="application@(application.Id)">
        <h2 id="application@(application.Id)">@application.ChildName</h2>
        @if (application.Status == StudentApplicationStatus.MoreInformationRequested && _editing?.Id != application.Id)
        {
            <p><strong>We need more information from you.</strong> <a href="/registration/my-applications?edit=@application.Id" aria-label="Answer and resubmit the application for @application.ChildName">Answer and resubmit</a></p>
        }
        @if (application.Status == StudentApplicationStatus.Approved)
        {
            <p>@application.ChildName is registered. See <a href="/parent/dashboard">your dashboard</a>.</p>
        }
        <ApplicationSummary Application="application" />
    </section>
}

<p><a class="btn btn--secondary" href="/registration/apply">Register another child</a></p>

@code {
    [SupplyParameterFromQuery(Name = "edit")]
    private int? Edit { get; set; }

    // No property initializer (BL0008): see Login.razor's identical comment.
    [SupplyParameterFromForm(FormName = "resubmit-application")]
    private ResubmitInput Input { get; set; } = default!;

    private List<ApplicationView> _applications = new();
    private ApplicationView? _editing;
    private readonly FormErrors _errors = new();
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (Input is null && _editing is { } editing)
        {
            // First view of the form: start from what the application holds now.
            Input = new ResubmitInput
            {
                Phone = editing.ParentPhone,
                PostalAddress = editing.ParentPostalAddress,
                Name = editing.ChildName,
                DateOfBirth = editing.ChildDateOfBirth.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                Relationship = editing.Relationship,
                PhotoMediaConsent = editing.PhotoMediaConsent,
                TransportConsent = editing.TransportConsent,
                OffsiteTripConsent = editing.OffsiteTripConsent,
                DataSharingConsent = editing.DataSharingConsent,
                EmergencyContact = editing.Details?.EmergencyContact,
                EmergencyMedicalInfo = editing.Details?.EmergencyMedicalInfo,
                DietaryRequirements = editing.Details?.DietaryRequirements,
                SpecialEducationalNeeds = editing.Details?.SpecialEducationalNeeds
            };
        }

        Input ??= new();
    }

    private async Task LoadAsync()
    {
        try
        {
            _applications = (await Applications.GetMyApplicationsAsync()).ToList();
            _editing = Edit is int id
                ? _applications.FirstOrDefault(a => a.Id == id && a.Status == StudentApplicationStatus.MoreInformationRequested)
                : null;
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ResubmitAsync()
    {
        if (_editing is not { } editing)
        {
            _errorMessage = "This application is not waiting for more information from you.";
            return;
        }

        // Find every problem at once, then stop if there are any.
        _errors.RequireText("response", Input.Response, ConsentSensitiveDetails.MaxTextLength, "Answer the question before resubmitting.",
            $"Your answer must be {ConsentSensitiveDetails.MaxTextLength} characters or fewer.");
        _errors.CheckApplicant(Input.Phone, Input.PostalAddress);
        var checkedDateOfBirth = _errors.CheckChild(
            "", "", Input.Name, Input.DateOfBirth, Input.Relationship, Input.EmergencyContact,
            Input.EmergencyMedicalInfo, Input.DietaryRequirements, Input.SpecialEducationalNeeds);
        if (_errors.Any || checkedDateOfBirth is not { } dateOfBirth)
        {
            return;
        }

        try
        {
            await Applications.ResubmitAsync(
                editing.Id,
                new ApplicantDetails(Input.Phone ?? "", Input.PostalAddress ?? ""),
                new ChildApplicationForm(
                    Input.Name ?? "", dateOfBirth, Input.Relationship ?? "", Input.PhotoMediaConsent, Input.TransportConsent,
                    Input.OffsiteTripConsent, Input.DataSharingConsent, Input.EmergencyContact ?? "", Input.EmergencyMedicalInfo,
                    Input.DietaryRequirements, Input.SpecialEducationalNeeds),
                Input.Response ?? "");
            _statusMessage = "Thank you. Your application has been resubmitted for review.";
            Edit = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class ResubmitInput
    {
        public string? Response { get; set; }
        public string? Phone { get; set; }
        public string? PostalAddress { get; set; }
        public string? Name { get; set; }
        public string? DateOfBirth { get; set; }
        public string? Relationship { get; set; }
        public bool PhotoMediaConsent { get; set; }
        public bool TransportConsent { get; set; }
        public bool OffsiteTripConsent { get; set; }
        public bool DataSharingConsent { get; set; }
        public string? EmergencyContact { get; set; }
        public string? EmergencyMedicalInfo { get; set; }
        public string? DietaryRequirements { get; set; }
        public string? SpecialEducationalNeeds { get; set; }
    }
}
