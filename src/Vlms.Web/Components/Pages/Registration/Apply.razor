@page "/registration/apply"
@attribute [Authorize(Policy = "RequireSignedIn")]
@using System.Globalization
@using Vlms.Infrastructure.Chapters
@using Vlms.Infrastructure.Registration
@inject StudentApplicationService Applications
@inject ChapterService Chapters

@* Static SSR (no @rendermode), so the form posts as a normal HTTP request; this is also what the
   request-level end-to-end test drives. Any signed-in adult can apply, holding no role yet
   (adr/0008 answer 1); the service refuses student sign-ins and leavers. Nothing is created but the
   application until a Safeguarding Officer and then an Admin approve it.

   Children are rendered in a loop with native inputs named "Input.Children[n].Field", which the
   form binding maps back onto the list; ids end in the child's number so each label matches.

   Every problem is found before anything is sent: an error summary lists them all at the top and each
   field carries its own message (aria-invalid / aria-describedby), keeping what was typed (WCAG 3.3.1, 3.3.3). *@

<PageTitle>Register a child</PageTitle>

<PageHeader Title="Register a child" />

<p class="intro">
    Apply to register one or more of your children with the Varangians. Choose the chapter at your
    parish, fill in your details, then a consent form for each child. That chapter's Safeguarding
    Officer reviews the application and may ask you for more information; its Admin then gives final
    approval. Until then your child is not registered.
    You can follow your applications on <a href="/registration/my-applications">My applications</a>.
</p>

<p class="muted">Shrewsbury Orthodox Church (charity 1166735) uses these details to review your application, plan safe activities and, if approved, register your child and support their participation. The chapter's Safeguarding Officer reviews the application and its Admin makes the final decision. The church relies on its legitimate interests in running the programme and protecting children; the health and safety details are handled under the data-protection conditions for a not-for-profit religious organisation. Activity choices such as photos, transport, trips and data sharing are based on the consent you give here, which you can change by contacting your chapter Admin. Applications are kept for up to one year after a decision, then flagged for deletion. For the full details about access, providers, retention and your rights, read <a href="/privacy">Privacy information</a>. You can contact the church at <a href="mailto:info@shrewsburyorthodox.com">info@shrewsburyorthodox.com</a> or complain to the <a href="https://ico.org.uk/make-a-complaint/">Information Commissioner's Office</a> (0303 123 1113).</p>

<FormErrorSummary Errors="_errors" />

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}

@if (_submittedCount > 0)
{
    <p role="status">
        Thank you. Your application@(_submittedCount == 1 ? " has" : "s have") been sent for review.
        We will email you when there is news. You can see the progress on <a href="/registration/my-applications">My applications</a>.
    </p>
}
else
{
<EditForm class="form" Model="Input" method="post" OnSubmit="HandleAsync" FormName="apply-registration">
    <h2>Your chapter</h2>
    <div class="field">
        <label for="chapter">The chapter at your parish</label>
        <select id="chapter" name="Input.ChapterId" aria-required="true" aria-invalid="@_errors.Invalid("chapter")" aria-describedby="@_errors.DescribedBy("chapter")">
            @if (_chapters.Count != 1)
            {
                <option value="" selected="@(Input.ChapterId is null)">Choose a chapter</option>
            }
            @foreach (var chapter in _chapters)
            {
                <option value="@chapter.Id" selected="@(Input.ChapterId == chapter.Id || _chapters.Count == 1)">@chapter.Name</option>
            }
        </select>
        @if (_errors.For("chapter") is { } chapterError)
        {
            <p class="field-error" id="chapter-error">@chapterError</p>
        }
    </div>

    <h2>Your details</h2>
    <div class="field">
        <label for="phone">Your phone number</label>
        <input id="phone" type="tel" autocomplete="tel" name="Input.Phone" value="@Input.Phone" aria-required="true" aria-invalid="@_errors.Invalid("phone")" aria-describedby="@_errors.DescribedBy("phone")" />
        @if (_errors.For("phone") is { } phoneError)
        {
            <p class="field-error" id="phone-error">@phoneError</p>
        }
    </div>
    <div class="field">
        <label for="postalAddress">Your postal address</label>
        <textarea id="postalAddress" rows="4" autocomplete="street-address" name="Input.PostalAddress" aria-required="true" aria-invalid="@_errors.Invalid("postalAddress")" aria-describedby="@_errors.DescribedBy("postalAddress")">@Input.PostalAddress</textarea>
        @if (_errors.For("postalAddress") is { } addressError)
        {
            <p class="field-error" id="postalAddress-error">@addressError</p>
        }
    </div>

    @for (var i = 0; i < Input.Children.Count; i++)
    {
        var n = i;
        var child = Input.Children[n];
        var nameId = $"childName{n}";
        var dobId = $"childDateOfBirth{n}";
        var relationshipId = $"relationship{n}";
        var emergencyId = $"emergencyContact{n}";
        <fieldset>
            <legend>Child @(n + 1)</legend>

            <h3>About the child</h3>
            <div class="field">
                <label for="childName@(n)">Child's full name</label>
                <input id="childName@(n)" name="Input.Children[@(n)].Name" value="@child.Name" autocomplete="off" aria-required="true" aria-invalid="@_errors.Invalid(nameId)" aria-describedby="@_errors.DescribedBy(nameId)" />
                @if (_errors.For(nameId) is { } nameError)
                {
                    <p class="field-error" id="childName@(n)-error">@nameError</p>
                }
            </div>
            <div class="field">
                <label for="childDateOfBirth@(n)">Child's date of birth</label>
                <input id="childDateOfBirth@(n)" type="date" name="Input.Children[@(n)].DateOfBirth" value="@child.DateOfBirth" aria-required="true" aria-invalid="@_errors.Invalid(dobId)" aria-describedby="@_errors.DescribedBy(dobId)" />
                @if (_errors.For(dobId) is { } dobError)
                {
                    <p class="field-error" id="childDateOfBirth@(n)-error">@dobError</p>
                }
            </div>
            <div class="field">
                <label for="relationship@(n)">Your relationship to the child (for example mother, father, grandparent, carer)</label>
                <input id="relationship@(n)" name="Input.Children[@(n)].Relationship" value="@child.Relationship" aria-required="true" aria-invalid="@_errors.Invalid(relationshipId)" aria-describedby="@_errors.DescribedBy(relationshipId)" />
                @if (_errors.For(relationshipId) is { } relationshipError)
                {
                    <p class="field-error" id="relationship@(n)-error">@relationshipError</p>
                }
            </div>

            <h3>Consent</h3>
            <div class="field--check">
                <input id="photo@(n)" type="checkbox" name="Input.Children[@(n)].PhotoMediaConsent" value="true" checked="@child.PhotoMediaConsent" />
                <label for="photo@(n)">I consent to photos and media of my child</label>
            </div>
            <div class="field--check">
                <input id="transport@(n)" type="checkbox" name="Input.Children[@(n)].TransportConsent" value="true" checked="@child.TransportConsent" />
                <label for="transport@(n)">I consent to my child being transported between our sites (this can be a short trip)</label>
            </div>
            <div class="field--check">
                <input id="offsite@(n)" type="checkbox" name="Input.Children[@(n)].OffsiteTripConsent" value="true" checked="@child.OffsiteTripConsent" />
                <label for="offsite@(n)">I consent to my child going on off-site trips and outings</label>
            </div>
            <div class="field--check">
                <input id="dataSharing@(n)" type="checkbox" name="Input.Children[@(n)].DataSharingConsent" value="true" checked="@child.DataSharingConsent" />
                <label for="dataSharing@(n)">I consent to data sharing</label>
            </div>

            <h3>Medical, dietary and emergency details</h3>
            <div class="field">
                <label for="emergencyContact@(n)">Emergency contact (name and phone number)</label>
                <input id="emergencyContact@(n)" name="Input.Children[@(n)].EmergencyContact" value="@child.EmergencyContact" aria-required="true" aria-invalid="@_errors.Invalid(emergencyId)" aria-describedby="@_errors.DescribedBy(emergencyId)" />
                @if (_errors.For(emergencyId) is { } emergencyError)
                {
                    <p class="field-error" id="emergencyContact@(n)-error">@emergencyError</p>
                }
            </div>
            <div class="field">
                <label for="medical@(n)">Emergency medical information (optional)</label>
                <textarea id="medical@(n)" name="Input.Children[@(n)].EmergencyMedicalInfo" rows="3" maxlength="4000" aria-invalid="@_errors.Invalid($"medical{n}")" aria-describedby="@_errors.DescribedBy($"medical{n}")">@child.EmergencyMedicalInfo</textarea>
                @if (_errors.For($"medical{n}") is { } medicalError)
                {
                    <p class="field-error" id="medical@(n)-error">@medicalError</p>
                }
            </div>
            <div class="field">
                <label for="dietary@(n)">Dietary requirements, including allergies (optional)</label>
                <textarea id="dietary@(n)" name="Input.Children[@(n)].DietaryRequirements" rows="4" maxlength="4000" aria-invalid="@_errors.Invalid($"dietary{n}")" aria-describedby="@_errors.DescribedBy($"dietary{n}")">@child.DietaryRequirements</textarea>
                @if (_errors.For($"dietary{n}") is { } dietaryError)
                {
                    <p class="field-error" id="dietary@(n)-error">@dietaryError</p>
                }
            </div>
            <div class="field">
                <label for="sen@(n)">Special educational needs (optional)</label>
                <textarea id="sen@(n)" name="Input.Children[@(n)].SpecialEducationalNeeds" rows="4" maxlength="4000" aria-invalid="@_errors.Invalid($"sen{n}")" aria-describedby="@_errors.DescribedBy($"sen{n}")">@child.SpecialEducationalNeeds</textarea>
                @if (_errors.For($"sen{n}") is { } senError)
                {
                    <p class="field-error" id="sen@(n)-error">@senError</p>
                }
            </div>
        </fieldset>
    }

    <div class="form-actions">
        <button type="submit" class="btn--secondary" name="Input.Command" value="add">Add another child</button>
        @if (Input.Children.Count > 1)
        {
            <button type="submit" class="btn--secondary" name="Input.Command" value="remove" aria-label="Remove child @(Input.Children.Count)">Remove the last child</button>
        }
    </div>
    <div class="form-actions">
        <button type="submit" name="Input.Command" value="submit">Send application</button>
    </div>
</EditForm>
}

@code {
    // No property initializer (BL0008): see Login.razor's identical comment.
    [SupplyParameterFromForm]
    private ApplicationInput Input { get; set; } = default!;

    private readonly FormErrors _errors = new();
    private string? _errorMessage;
    private int _submittedCount;
    private IReadOnlyList<ChapterSummary> _chapters = [];

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // The open chapters (FR-021): that chapter's Safeguarding Officer and Admin decide.
        _chapters = await Chapters.ListOpenAsync();
        if (Input.ChapterId is null && _chapters.Count == 1)
        {
            Input.ChapterId = _chapters[0].Id;
        }
        if (Input.Children.Count == 0)
        {
            Input.Children.Add(new ChildInput());
        }
    }

    private async Task HandleAsync()
    {
        _errorMessage = null;
        switch (Input.Command)
        {
            case "add":
                Input.Children.Add(new ChildInput());
                return;
            case "remove" when Input.Children.Count > 1:
                Input.Children.RemoveAt(Input.Children.Count - 1);
                return;
        }

        // Find every problem at once, then stop if there are any.
        if (Input.ChapterId is null || _chapters.All(c => c.Id != Input.ChapterId))
        {
            _errors.Add("chapter", "Choose the chapter at your parish.");
        }
        _errors.CheckApplicant(Input.Phone, Input.PostalAddress);
        var forms = new List<ChildApplicationForm>();
        for (var n = 0; n < Input.Children.Count; n++)
        {
            var child = Input.Children[n];
            var who = Input.Children.Count == 1 ? "" : $"child {n + 1}";
            var dateOfBirth = _errors.CheckChild(
                n.ToString(CultureInfo.InvariantCulture), who, child.Name, child.DateOfBirth, child.Relationship,
                child.EmergencyContact, child.EmergencyMedicalInfo, child.DietaryRequirements, child.SpecialEducationalNeeds);
            if (dateOfBirth is { } dob)
            {
                forms.Add(new ChildApplicationForm(
                    child.Name ?? "", dob, child.Relationship ?? "", child.PhotoMediaConsent, child.TransportConsent,
                    child.OffsiteTripConsent, child.DataSharingConsent, child.EmergencyContact ?? "", child.EmergencyMedicalInfo,
                    child.DietaryRequirements, child.SpecialEducationalNeeds));
            }
        }

        if (_errors.Any)
        {
            return;
        }

        try
        {
            var created = await Applications.SubmitAsync(Input.ChapterId!.Value, new ApplicantDetails(Input.Phone ?? "", Input.PostalAddress ?? ""), forms);
            _submittedCount = created.Count;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class ApplicationInput
    {
        public int? ChapterId { get; set; }
        public string? Phone { get; set; }
        public string? PostalAddress { get; set; }
        public List<ChildInput> Children { get; set; } = new();
        public string? Command { get; set; }
    }

    private sealed class ChildInput
    {
        public string? Name { get; set; }
        public string? DateOfBirth { get; set; }
        public string? Relationship { get; set; }
        public bool PhotoMediaConsent { get; set; }
        public bool TransportConsent { get; set; }
        public bool OffsiteTripConsent { get; set; }
        public bool DataSharingConsent { get; set; }
        public string? EmergencyContact { get; set; }
        public string? EmergencyMedicalInfo { get; set; }
        public string? DietaryRequirements { get; set; }
        public string? SpecialEducationalNeeds { get; set; }
    }
}
