@* Error summary for the registration forms (WCAG 3.3.1): one link per problem, each going to its field. *@
@if (Errors.Any)
{
    <div class="error" role="alert" tabindex="-1" id="error-summary">
        <h2>There is a problem</h2>
        <ul>
            @foreach (var (fieldId, message) in Errors.All)
            {
                <li><a href="#@fieldId">@message</a></li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public FormErrors Errors { get; set; } = default!;
}
