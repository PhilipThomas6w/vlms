@page "/safeguarding/consent"
@attribute [Authorize(Policy = "RequireAdminOrSafeguardingOfficer")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Safeguarding
@inject VlmsDbContext Db
@inject ConsentRecordService ConsentService

<PageTitle>Consent records</PageTitle>

<h1>Consent records</h1>

<p>
    <code>ConsentRecord</code>/<code>ConsentSensitiveDetails</code> management — Admin or
    Safeguarding Officer only (functional.md FR-001, FR-015,
    adr/0006-parent-consent-and-teacher-read-access.md). Parents submit the annual consent form
    themselves; review each pending submission below and approve it, or reject it with comments
    the parent will see. Approving applies the name and date of birth on the form to the student's
    record. The Approver role is curriculum-only and has no access here.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<h2>Pending submissions</h2>
@{
    var pending = _records.Where(r => r.Status == ConsentStatus.Pending).OrderBy(r => r.Id).ToList();
}
@if (pending.Count == 0)
{
    <p>No submissions are awaiting review.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Student</th>
                <th>Submitted by</th>
                <th>Submitted</th>
                <th>Period</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in pending)
            {
                <tr>
                    <td>@_studentNames.GetValueOrDefault(record.StudentId)</td>
                    <td>@_guardianNames.GetValueOrDefault(record.SubmittedByParentId)@(record.SubmittedByUserId is { } enteredBy && _parentUserIds.Contains(enteredBy) ? "" : " (entered by staff)")</td>
                    <td>@record.SubmittedAt?.ToString("d MMMM yyyy HH:mm")</td>
                    <td>@record.PeriodStart - @record.PeriodEnd</td>
                    <td><button @onclick="() => StartReview(record.Id)">Review</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_reviewRecord is { } review)
{
    var details = _sensitiveDetailsByRecordId.GetValueOrDefault(review.Id);
    var student = _students.FirstOrDefault(s => s.Id == review.StudentId);
    var studentChanges = ConsentReviewComparison.CompareStudentDetails(review, student);
    var inForce = ConsentReviewComparison.FindInForce(_records, review.StudentId, DateOnly.FromDateTime(DateTime.UtcNow));
    var inForceChanges = ConsentReviewComparison.CompareWithInForce(
        review, details, inForce, inForce is null ? null : _sensitiveDetailsByRecordId.GetValueOrDefault(inForce.Id));
    <section aria-labelledby="reviewHeading">
        <h2 id="reviewHeading">Review submission for @_studentNames.GetValueOrDefault(review.StudentId)</h2>
        @if (studentChanges.Any(f => f.Changed))
        {
            <p role="alert"><strong>Check before approving:</strong> approving will replace the student's details on record with the details on this form. Changed: @string.Join(", ", studentChanges.Where(f => f.Changed).Select(f => f.Label.ToLowerInvariant())).</p>
        }
        <dl>
            @foreach (var field in studentChanges)
            {
                <dt>@field.Label on form</dt>
                <dd class="@(field.Changed ? "review-changed" : null)">
                    @if (field.Changed)
                    {
                        <strong>Changed:</strong> <span>was @field.Current on record, now @field.Submitted on form</span>
                    }
                    else
                    {
                        <span>@field.Submitted (same as record)</span>
                    }
                </dd>
            }
            <dt>Period</dt>
            <dd>@review.PeriodStart.ToString("d MMMM yyyy") to @review.PeriodEnd.ToString("d MMMM yyyy") (expires @review.ExpiryDate.ToString("d MMMM yyyy"))</dd>
            <dt>Photo/media consent</dt>
            <dd>@(review.PhotoMediaConsent ? "Yes" : "No")</dd>
            <dt>Transport/off-site consent</dt>
            <dd>@(review.TransportOffsiteConsent ? "Yes" : "No")</dd>
            <dt>Data-sharing consent</dt>
            <dd>@(review.DataSharingConsent ? "Yes" : "No")</dd>
            <dt>Emergency contact</dt>
            <dd>@details?.EmergencyContact</dd>
            <dt>Emergency medical info</dt>
            <dd>@(details?.EmergencyMedicalInfo ?? "None given")</dd>
            <dt>Dietary/SEN needs</dt>
            <dd>@(details?.DietarySEN ?? "None given")</dd>
        </dl>
        @if (inForceChanges.Count > 0)
        {
            <h3>Compared with the consent currently in force</h3>
            <table>
                <thead>
                    <tr><th>Field</th><th>In force</th><th>Submitted</th><th>Result</th></tr>
                </thead>
                <tbody>
                    @foreach (var field in inForceChanges)
                    {
                        <tr class="@(field.Changed ? "review-changed" : null)">
                            <th scope="row">@field.Label</th>
                            <td>@field.Current</td>
                            <td>@field.Submitted</td>
                            <td>@(field.Changed ? "Changed" : "Same")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div>
            <label for="decisionComments">Comments (required to reject; the parent will see them)</label>
            <InputTextArea id="decisionComments" @bind-Value="_decisionComments" />
        </div>
        <button @onclick="() => DecideAsync(review.Id, approve: true)">Approve</button>
        <button @onclick="() => DecideAsync(review.Id, approve: false)">Reject</button>
        <button @onclick="CancelReview">Cancel</button>
    </section>
}

<h2>All records</h2>
<table>
    <thead>
        <tr>
            <th>Student</th>
            <th>Period</th>
            <th>Expiry</th>
            <th>Status</th>
            <th>Emergency contact</th>
            <th>Comments</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in _records)
        {
            <tr>
                <td>@_studentNames.GetValueOrDefault(record.StudentId)</td>
                <td>@record.PeriodStart - @record.PeriodEnd</td>
                <td>@record.ExpiryDate</td>
                <td>@record.Status</td>
                <td>@(_sensitiveDetailsByRecordId.GetValueOrDefault(record.Id)?.EmergencyContact)</td>
                <td>@record.DecisionComments</td>
            </tr>
        }
    </tbody>
</table>

<h2>Record a paper consent form</h2>
<p>For a form a parent has handed in on paper. It is created as pending and reviewed above like any other submission.</p>
<EditForm Model="_form" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary role="alert" />

    <div>
        <label for="student">Student</label>
        <InputSelect id="student" @bind-Value="_form.StudentId">
            @foreach (var student in _students)
            {
                <option value="@student.Id">@student.Name</option>
            }
        </InputSelect>
    </div>
    <div>
        <label for="parent">Submitted by (parent/guardian)</label>
        <InputSelect id="parent" @bind-Value="_form.SubmittedByParentId">
            @foreach (var guardian in _guardians)
            {
                <option value="@guardian.Id">@guardian.Name</option>
            }
        </InputSelect>
    </div>
    <div>
        <label for="periodStart">Period start</label>
        <InputDate id="periodStart" @bind-Value="_form.PeriodStart" />
    </div>
    <div>
        <label for="periodEnd">Period end</label>
        <InputDate id="periodEnd" @bind-Value="_form.PeriodEnd" />
    </div>
    <div>
        <label for="expiryDate">Expiry date</label>
        <InputDate id="expiryDate" @bind-Value="_form.ExpiryDate" />
    </div>
    <div>
        <label><InputCheckbox @bind-Value="_form.PhotoMediaConsent" /> Photo/media consent</label>
    </div>
    <div>
        <label><InputCheckbox @bind-Value="_form.TransportOffsiteConsent" /> Transport/off-site consent</label>
    </div>
    <div>
        <label><InputCheckbox @bind-Value="_form.DataSharingConsent" /> Data-sharing consent</label>
    </div>
    <div>
        <label for="emergencyContact">Emergency contact</label>
        <InputText id="emergencyContact" @bind-Value="_form.EmergencyContact" />
    </div>
    <div>
        <label for="medicalInfo">Emergency medical info</label>
        <InputTextArea id="medicalInfo" @bind-Value="_form.EmergencyMedicalInfo" />
    </div>
    <div>
        <label for="dietarySen">Dietary/SEN needs</label>
        <InputTextArea id="dietarySen" @bind-Value="_form.DietarySEN" />
    </div>

    <button type="submit">Record consent</button>
</EditForm>

@code {
    private List<Student> _students = new();
    private List<ParentGuardian> _guardians = new();
    private List<ConsentRecord> _records = new();
    private Dictionary<int, string> _studentNames = new();
    private Dictionary<int, ConsentSensitiveDetails> _sensitiveDetailsByRecordId = new();
    private Dictionary<int, string> _guardianNames = new();
    private HashSet<int> _parentUserIds = new();
    private ConsentRecord? _reviewRecord;
    private string? _decisionComments;
    private ConsentFormModel _form = new();
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _students = await Db.Students.OrderBy(s => s.Name).ToListAsync();
        _guardians = await Db.ParentGuardians.OrderBy(g => g.Name).ToListAsync();
        _records = await Db.ConsentRecords.OrderByDescending(c => c.ExpiryDate).ToListAsync();
        _studentNames = _students.ToDictionary(s => s.Id, s => s.Name);
        _guardianNames = _guardians.ToDictionary(g => g.Id, g => g.Name);
        _parentUserIds = _guardians.Where(g => g.AppUserId is not null).Select(g => g.AppUserId!.Value).ToHashSet();

        // Subject to adr/0004's query filter — only resolves rows at all because this page is
        // gated to Admin/SafeguardingOfficer; every row materialized here writes a
        // SensitiveDataAccessLog entry via the existing SensitiveDataAuditInterceptor.
        var details = await Db.ConsentSensitiveDetails.ToListAsync();
        _sensitiveDetailsByRecordId = details.ToDictionary(d => d.ConsentRecordId, d => d);

        if (_form.StudentId == 0)
        {
            _form.StudentId = _students.FirstOrDefault()?.Id ?? 0;
        }

        if (_form.SubmittedByParentId == 0)
        {
            _form.SubmittedByParentId = _guardians.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await ConsentService.RecordAsync(
                _form.StudentId,
                DateOnly.FromDateTime(_form.PeriodStart),
                DateOnly.FromDateTime(_form.PeriodEnd),
                DateOnly.FromDateTime(_form.ExpiryDate),
                _form.PhotoMediaConsent,
                _form.TransportOffsiteConsent,
                _form.DataSharingConsent,
                _form.SubmittedByParentId,
                _form.EmergencyContact,
                string.IsNullOrWhiteSpace(_form.EmergencyMedicalInfo) ? null : _form.EmergencyMedicalInfo,
                string.IsNullOrWhiteSpace(_form.DietarySEN) ? null : _form.DietarySEN);

            _form = new ConsentFormModel();
            _statusMessage = "Consent record created.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or ArgumentException)
        {
            _errorMessage = ex.Message;
        }
    }

    private void StartReview(int consentRecordId)
    {
        _errorMessage = null;
        _statusMessage = null;
        _decisionComments = null;
        _reviewRecord = _records.FirstOrDefault(r => r.Id == consentRecordId);
    }

    private void CancelReview()
    {
        _reviewRecord = null;
        _decisionComments = null;
    }

    private async Task DecideAsync(int consentRecordId, bool approve)
    {
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await ConsentService.DecideAsync(consentRecordId, approve, _decisionComments);
            _statusMessage = approve ? "Consent record approved." : "Consent record rejected.";
            CancelReview();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or ArgumentException)
        {
            _errorMessage = ex.Message;
        }
    }

    // EmergencyMedicalInfo/DietarySEN are deliberately not [Required] (ConsentSensitiveDetails
    // itself only requires EmergencyContact — see the entity) — blank is mapped to null before
    // calling the service, matching data-design.md's nullable fields.
    private sealed class ConsentFormModel
    {
        public int StudentId { get; set; }
        public int SubmittedByParentId { get; set; }
        public DateTime PeriodStart { get; set; } = DateTime.Today;
        public DateTime PeriodEnd { get; set; } = DateTime.Today.AddYears(1);
        public DateTime ExpiryDate { get; set; } = DateTime.Today.AddYears(1);
        public bool PhotoMediaConsent { get; set; }
        public bool TransportOffsiteConsent { get; set; }
        public bool DataSharingConsent { get; set; }

        [Required]
        public string EmergencyContact { get; set; } = "";

        public string EmergencyMedicalInfo { get; set; } = "";
        public string DietarySEN { get; set; } = "";
    }
}
