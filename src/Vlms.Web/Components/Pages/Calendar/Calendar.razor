@page "/calendar"
@attribute [Authorize(Policy = "RequireChapterMember")]
@rendermode InteractiveServer
@using System.Globalization
@using Vlms.Domain
@using Vlms.Infrastructure.Calendar
@inject CalendarService CalendarService
@inject CalendarFeedService Feeds
@inject NavigationManager Navigation
@inject ICurrentUserContext CurrentUser

@* The calendar (docs/requirements/functional.md, the calendar requirement): each day's main feast and
   fast from the Church's calendar, with the chapter's own events; saints and readings open from the
   day. Shown as a list or a month grid, as each person last chose. Admins add events; everyone in the
   chapter can make a private subscribe link, and sees the chapter's public link (parish events only),
   which its Admins make, replace or stop. *@

<PageTitle>Calendar – Varangians</PageTitle>

<div class="calendar">
    <PageHeader Title="Calendar">
        <Actions>
            <AuthorizeView Policy="RequireAdmin">
                <a class="btn" href="/calendar/events/new"><Icon Name="calendar" /> Add an event</a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    @if (_errorMessage is not null)
    {
        <Notice Kind="danger" Role="alert"><p>@_errorMessage</p></Notice>
    }

    <nav class="calendar__months" aria-label="Months">
        <a class="btn btn--secondary" href="@MonthHref(_first.AddMonths(-1))">
            <span aria-hidden="true">‹</span> @_first.AddMonths(-1).ToString("MMMM yyyy", Uk)
        </a>
        <h2 id="month-heading" class="calendar__month">@_first.ToString("MMMM yyyy", Uk)</h2>
        <a class="btn btn--secondary" href="@MonthHref(_first.AddMonths(1))">
            @_first.AddMonths(1).ToString("MMMM yyyy", Uk) <span aria-hidden="true">›</span>
        </a>
    </nav>

    @if (_month is null)
    {
        <p class="muted" role="status">Loading the calendar…</p>
    }
    else
    {
        @* Until the person chooses, both views are rendered and the width picks one (the list on phones,
           the grid on wider screens); once chosen, only that view is rendered, at every width. *@
        <div class="calendar__views @(_view is null ? "calendar__views--auto" : null)">
        @if (_view != CalendarView.Grid)
        {
        <div class="calendar__view calendar__view--list">
        @ViewSwitch(CalendarView.List)
        <ol class="calendar__days" aria-labelledby="month-heading">
            @foreach (var day in _month.Days)
            {
                var isToday = day.Date == Today;
                var panelId = $"day-{day.Date:yyyyMMdd}";
                <li class="day @(isToday ? "day--today" : null) @(day.Events.Count > 0 ? "day--event" : null)" aria-current="@(isToday ? "date" : null)">
                    <p class="day__date">
                        <span class="day__weekday">@day.Date.ToString("ddd", Uk)</span>
                        <span class="day__number">@day.Date.Day</span>
                        <span class="visually-hidden">@day.Date.ToString("MMMM", Uk)</span>
                    </p>
                    <div class="day__body">
                        @foreach (var item in day.Events)
                        {
                            <p class="day__event">
                                <Icon Name="calendar" />
                                <a href="/calendar/events/@item.Id">@item.Title</a>
                                <span class="pill">@item.Kind.Label()</span>
                                @if (item.StartTime is { } start)
                                {
                                    <span class="day__time">@Times(start, item.EndTime)</span>
                                }
                            </p>
                        }
                        @if (day.Feast is not null)
                        {
                            <p class="day__feast">
                                <span>@day.Feast</span>
                                <FastPill Fast="day.Fast" />
                            </p>
                            <button type="button" class="btn--quiet day__toggle" aria-expanded="@(_open.ContainsKey(day.Date) ? "true" : "false")"
                                    aria-controls="@panelId" @onclick="() => ToggleAsync(day.Date)">
                                Saints and readings <span class="visually-hidden">for @day.Date.ToString("d MMMM", Uk)</span>
                            </button>
                            @if (_open.TryGetValue(day.Date, out var detail))
                            {
                                <div class="day__detail" id="@panelId">
                                    @if (detail is null)
                                    {
                                        <p class="muted">Loading…</p>
                                    }
                                    else
                                    {
                                        <h3>Saints and feasts</h3>
                                        <ul class="day__saints">
                                            @foreach (var saint in detail.Saints)
                                            {
                                                <li>@saint</li>
                                            }
                                        </ul>
                                        @foreach (var reading in detail.Readings)
                                        {
                                            <h3>@reading.Heading: @reading.Reference</h3>
                                            <p class="preserve-lines">@reading.Text</p>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
        </div>
        }
        @if (_view != CalendarView.List)
        {
        <div class="calendar__view calendar__view--grid">
        @ViewSwitch(CalendarView.Grid)
        <div class="month-grid__scroll">
        <table class="month-grid" aria-labelledby="month-heading">
            <thead>
                <tr>
                    @foreach (var weekday in Weekdays)
                    {
                        <th scope="col"><span aria-hidden="true">@weekday[..3]</span><span class="visually-hidden">@weekday</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var week in Weeks(_month))
                {
                    <tr>
                        @foreach (var day in week)
                        {
                            if (day is null)
                            {
                                <td class="cell cell--blank"></td>
                                continue;
                            }

                            var isToday = day.Date == Today;
                            var isSelected = day.Date == _selected;
                            <td class="cell @(isToday ? "cell--today" : null) @(day.Events.Count > 0 ? "cell--event" : null) @(isSelected ? "cell--selected" : null)"
                                aria-current="@(isToday ? "date" : null)">
                                <button type="button" class="cell__button" aria-expanded="@(isSelected ? "true" : "false")"
                                        aria-controls="selected-day" @onclick="() => SelectAsync(day.Date)">
                                    <span class="cell__number">@day.Date.Day<span class="visually-hidden"> @day.Date.ToString("MMMM", Uk)</span></span>
                                    @foreach (var item in day.Events)
                                    {
                                        <span class="cell__event"><span class="cell__dot @(item.Kind.IsVarangians() ? null : "cell__dot--parish")" aria-hidden="true"></span><span class="cell__text">@item.Title<span class="visually-hidden"> (@item.Kind.Label())</span></span></span>
                                    }
                                    @if (day.Feast is not null)
                                    {
                                        <span class="cell__feast cell__text">@day.Feast</span>
                                    }
                                    <FastPill Fast="day.Fast" Short="true" />
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (_selected is { } selected && _month.Days.FirstOrDefault(d => d.Date == selected) is { } chosen)
        {
            <section id="selected-day" class="panel selected-day" aria-labelledby="selected-day-heading">
                <h3 id="selected-day-heading">@selected.ToString("dddd d MMMM yyyy", Uk)</h3>
                @foreach (var item in chosen.Events)
                {
                    <p class="day__event">
                        <Icon Name="calendar" />
                        <a href="/calendar/events/@item.Id">@item.Title</a>
                        <span class="pill">@item.Kind.Label()</span>
                        @if (item.StartTime is { } start)
                        {
                            <span class="day__time">@Times(start, item.EndTime)</span>
                        }
                    </p>
                }
                @if (chosen.Feast is not null)
                {
                    <p class="day__feast">
                        <span>@chosen.Feast</span>
                        <FastPill Fast="chosen.Fast" />
                    </p>
                }
                @if (_selectedLoading)
                {
                    <p class="muted">Loading…</p>
                }
                else if (_selectedDetail is { } detail)
                {
                    <h4>Saints and feasts</h4>
                    <ul class="day__saints">
                        @foreach (var saint in detail.Saints)
                        {
                            <li>@saint</li>
                        }
                    </ul>
                    @foreach (var reading in detail.Readings)
                    {
                        <h4>@reading.Heading: @reading.Reference</h4>
                        <p class="preserve-lines">@reading.Text</p>
                    }
                }
            </section>
        }
        </div>
        }
        </div>
    }

    <section class="section panel calendar__subscribe" aria-labelledby="subscribe-heading">
        <h2 id="subscribe-heading">Subscribe in your calendar app</h2>
        <p>Your own link adds this chapter's events to your calendar app. Keep it private: anyone with the link can see the events.</p>
        @if (_newLink is not null)
        {
            <div class="field">
                <label for="feed-link">Your link</label>
                <input id="feed-link" type="text" readonly value="@_newLink" />
            </div>
            <p class="muted">This link is shown only now. Copy it into your calendar app's "subscribe" or "add by URL" option.</p>
        }
        else if (_linkCreatedAt is { } created)
        {
            <p>You made a link on @created.ToLocalTime().ToString("d MMMM yyyy", Uk). Making a new one stops the old one working.</p>
        }
        <div class="btn-row">
            <button type="button" @onclick="CreateLinkAsync">@(_linkCreatedAt is null && _newLink is null ? "Make my link" : "Make a new link")</button>
            @if (_linkCreatedAt is not null || _newLink is not null)
            {
                <button type="button" class="btn--secondary" @onclick="RemoveLinkAsync">Stop my link</button>
            }
        </div>
    </section>

    @if (_publicKey is not null || _isAdmin)
    {
        <section class="section panel calendar__subscribe" aria-labelledby="public-heading">
            <h2 id="public-heading">The chapter's public calendar</h2>
            <p>A link anyone can subscribe to, with the chapter's parish events only: services and parish meetings, never classes or excursions.</p>
            @if (_publicKey is not null)
            {
                <div class="field">
                    <label for="public-link">Public link</label>
                    <input id="public-link" type="text" readonly value="@PublicLink(_publicKey)" />
                </div>
            }
            @if (_isAdmin)
            {
                @if (_confirmPublic is { } action)
                {
                    <p>@(action == PublicAction.Replace ? "Make a new public link? The old one stops working for everyone subscribed to it." : "Stop the public link? It stops working for everyone subscribed to it.")</p>
                    <div class="btn-row">
                        <button type="button" class="@(action == PublicAction.Stop ? "btn--danger" : null)" @onclick="ConfirmPublicAsync">@(action == PublicAction.Replace ? "Make a new public link" : "Stop the public link")</button>
                        <button type="button" class="btn--secondary" @onclick="() => _confirmPublic = null">Keep it</button>
                    </div>
                }
                else
                {
                    <div class="btn-row">
                        @if (_publicKey is null)
                        {
                            <button type="button" @onclick="CreatePublicLinkAsync">Make the public link</button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => _confirmPublic = PublicAction.Replace">Make a new public link</button>
                            <button type="button" class="btn--secondary" @onclick="() => _confirmPublic = PublicAction.Stop">Stop the public link</button>
                        }
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private static readonly CultureInfo Uk = CultureInfo.GetCultureInfo("en-GB");
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    [SupplyParameterFromQuery(Name = "month")] public string? Month { get; set; }

    private static readonly string[] Weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private DateOnly _first;
    private CalendarMonth? _month;
    private CalendarView? _view;
    private readonly Dictionary<DateOnly, LiturgicalDayDetail?> _open = new();
    private DateOnly? _selected;
    private LiturgicalDayDetail? _selectedDetail;
    private bool _selectedLoading;
    private DateTime? _linkCreatedAt;
    private string? _newLink;
    private string? _publicKey;
    private bool _isAdmin;
    private PublicAction? _confirmPublic;

    private enum PublicAction { Replace, Stop }
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Set before the first await: Blazor renders while that await is pending, before
        // OnParametersSetAsync runs, and a default _first (01/01/0001) can't step back a month.
        _first = FirstOfMonth(Month);
        try
        {
            _linkCreatedAt = await Feeds.GetLinkCreatedAtAsync();
            _publicKey = await Feeds.GetPublicLinkKeyAsync();
            _isAdmin = CurrentUser.HasRole(Role.Admin);
            _view = await CalendarService.GetViewAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _first = FirstOfMonth(Month);
        _open.Clear();
        _selected = null;
        _selectedDetail = null;
        try
        {
            _month = await CalendarService.GetMonthAsync(_first.Year, _first.Month);
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private static DateOnly FirstOfMonth(string? value) =>
        DateOnly.TryParseExact(value, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month)
            ? month
            : new DateOnly(Today.Year, Today.Month, 1);

    private static string MonthHref(DateOnly month) => $"/calendar?month={month:yyyy-MM}";

    private static string Times(TimeOnly start, TimeOnly? end) =>
        end is { } finish ? $"{start:HH:mm}–{finish:HH:mm}" : start.ToString("HH:mm", Uk);

    private async Task ToggleAsync(DateOnly date)
    {
        if (_open.Remove(date))
        {
            return;
        }

        _open[date] = null;
        _open[date] = await CalendarService.GetLiturgicalDayAsync(date);
    }

    // The grid's weeks, Monday first, with null for the days outside the month.
    private static IEnumerable<CalendarDay?[]> Weeks(CalendarMonth month)
    {
        var lead = ((int)month.Days[0].Date.DayOfWeek + 6) % 7;
        var cells = Enumerable.Repeat<CalendarDay?>(null, lead).Concat(month.Days).ToList();
        while (cells.Count % 7 != 0)
        {
            cells.Add(null);
        }

        return cells.Chunk(7);
    }

    // A day tapped in the grid opens below it; tapping it again closes it.
    private async Task SelectAsync(DateOnly date)
    {
        _selectedDetail = null;
        if (_selected == date)
        {
            _selected = null;
            return;
        }

        _selected = date;
        _selectedLoading = true;
        try
        {
            var detail = await CalendarService.GetLiturgicalDayAsync(date);
            if (_selected == date)
            {
                _selectedDetail = detail;
            }
        }
        finally
        {
            _selectedLoading = false;
        }
    }

    private async Task ChooseAsync(CalendarView view)
    {
        _view = view;
        await CalendarService.SetViewAsync(view);
    }

    private RenderFragment ViewSwitch(CalendarView shown) =>
        @<div class="view-switch" role="group" aria-label="Show the month as">
            <button type="button" aria-pressed="@(shown == CalendarView.List ? "true" : "false")" @onclick="() => ChooseAsync(CalendarView.List)">List</button>
            <button type="button" aria-pressed="@(shown == CalendarView.Grid ? "true" : "false")" @onclick="() => ChooseAsync(CalendarView.Grid)">Grid</button>
        </div>;

    private async Task CreateLinkAsync()
    {
        var secret = await Feeds.CreateLinkAsync();
        _newLink = Navigation.ToAbsoluteUri($"/calendar/feed/{secret}.ics").ToString();
        _linkCreatedAt = null;
    }

    private string PublicLink(string key) => Navigation.ToAbsoluteUri($"/calendar/chapter/{key}.ics").ToString();

    private async Task CreatePublicLinkAsync() => _publicKey = await Feeds.CreatePublicLinkAsync();

    private async Task ConfirmPublicAsync()
    {
        if (_confirmPublic == PublicAction.Replace)
        {
            _publicKey = await Feeds.CreatePublicLinkAsync();
        }
        else
        {
            await Feeds.RemovePublicLinkAsync();
            _publicKey = null;
        }

        _confirmPublic = null;
    }

    private async Task RemoveLinkAsync()
    {
        await Feeds.RemoveLinkAsync();
        _newLink = null;
        _linkCreatedAt = null;
    }
}
