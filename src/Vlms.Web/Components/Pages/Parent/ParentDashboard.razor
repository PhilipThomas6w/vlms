@page "/parent/dashboard"
@attribute [Authorize(Policy = "RequireParent")]
@rendermode InteractiveServer
@using Vlms.Infrastructure.Engagement
@using Vlms.Web
@inject ParentDashboardService DashboardService

<PageTitle>My dashboard</PageTitle>

<h1>My dashboard</h1>

<p>
    Progress, badges, certificates and consent status for your children. You see only the children
    an Admin or Teacher has linked to your account; no other student's information is shown.
</p>

<p><a href="/parent/student-sign-ins">Create a sign-in or reset a password for your children</a></p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
else if (_students.Count == 0)
{
    <p>No students are currently linked to your account.</p>
}
else
{
    @foreach (var student in _students)
    {
        <section>
            <h2>@student.StudentName</h2>
            <p>
                Current rank: <strong>@student.CurrentRankName</strong>
                @if (student.CurrentRankStartedAt is { } startedAt)
                {
                    <span> (since @startedAt.ToString("d MMMM yyyy"))</span>
                }
            </p>

            <p>
                Consent status:
                @if (student.ConsentStatus is { } status)
                {
                    <span><strong>@status</strong> (expires @student.ConsentExpiryDate)</span>
                }
                else
                {
                    <strong>No consent record on file</strong>
                }
            </p>

            <h3>Badges</h3>
            @if (student.Badges.Count == 0)
            {
                <p>No badges yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var badge in student.Badges)
                    {
                        <li>
                            @if (badge.HasImage)
                            {
                                <img src="/badges/@badge.RankId/image" alt="@badge.RankName badge" width="48" height="48" />
                                <span> </span>
                            }
                            @badge.RankName — @badge.AwardedAt.ToString("d MMMM yyyy")
                        </li>
                    }
                </ul>
            }

            <h3>Certificates</h3>
            @if (student.Certificates.Count == 0)
            {
                <p>No certificates yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var certificate in student.Certificates)
                    {
                        <li>
                            @certificate.LessonTitle — @certificate.GeneratedAt.ToString("d MMMM yyyy")
                            (<a href="@CertificateEndpoint.ViewUrl(certificate.CertificateId)" target="_blank" rel="noopener" aria-label="View certificate for @certificate.LessonTitle (opens in a new tab)" data-enhance-nav="false">View</a>
                            | <a href="@CertificateEndpoint.DownloadUrl(certificate.CertificateId)" aria-label="Download certificate for @certificate.LessonTitle" data-enhance-nav="false">Download</a>)
                        </li>
                    }
                </ul>
            }
        </section>
    }
}

@code {
    private List<ParentDashboardStudent> _students = new();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _students = (await DashboardService.GetDashboardAsync()).ToList();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
