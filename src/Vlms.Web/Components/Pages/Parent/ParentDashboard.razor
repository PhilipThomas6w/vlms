@page "/parent/dashboard"
@attribute [Authorize(Policy = "RequireParent")]
@rendermode InteractiveServer
@using Vlms.Infrastructure.Engagement
@using Vlms.Web
@inject ParentDashboardService DashboardService

<PageTitle>My dashboard</PageTitle>

<PageHeader Title="My dashboard" />

<p class="intro">
    Progress, badges, certificates and consent status for your children. You see only the children
    an Admin has linked to your account; no other student's information is shown.
</p>

<p><a href="/parent/student-sign-ins">Create a sign-in or reset a password for your children</a></p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
else if (_students.Count == 0)
{
    <p>No students are currently linked to your account.</p>
}
else
{
    <div class="children">
    @foreach (var student in _students)
    {
        <section class="child rank-@student.CurrentRankOrder" aria-labelledby="child-@student.StudentId">
            <div class="child__head">
                <RankMedallion RankId="student.CurrentRankId" Order="student.CurrentRankOrder" RankName="@student.CurrentRankName"
                               HasBadgeImage="student.CurrentRankHasBadgeImage" Earned="false" Current="true" Alt="" />
                <div>
                    <h2 id="child-@student.StudentId">@student.StudentName</h2>
                    <p>
                        Current rank: <strong>@student.CurrentRankName</strong>
                        @if (student.CurrentRankStartedAt is { } startedAt)
                        {
                            <span> (since @startedAt.ToString("d MMMM yyyy"))</span>
                        }
                    </p>
                </div>
            </div>

            <p class="child__consent">
                Consent status:
                @if (student.ConsentStatus is { } status)
                {
                    <span class="pill @ConsentPill(status)">@status</span>
                    <span>(expires @student.ConsentExpiryDate)</span>
                }
                else
                {
                    <span class="pill pill--warning"><Icon Name="alert" /> No consent record on file</span>
                }
            </p>

            <h3>Badges</h3>
            @if (student.Badges.Count == 0)
            {
                <p>No badges yet.</p>
            }
            else
            {
                <ul class="badge-row">
                    @foreach (var badge in student.Badges)
                    {
                        <li class="rank-@badge.RankOrder">
                            <RankMedallion RankId="badge.RankId" Order="badge.RankOrder" RankName="@badge.RankName" HasBadgeImage="badge.HasImage" Size="sm" Alt="" />
                            <span>@badge.RankName — @badge.AwardedAt.ToString("d MMMM yyyy")</span>
                        </li>
                    }
                </ul>
            }

            <h3>Certificates</h3>
            @if (student.Certificates.Count == 0)
            {
                <p>No certificates yet.</p>
            }
            else
            {
                <ul class="rows">
                    @foreach (var certificate in student.Certificates)
                    {
                        <li class="cert-row">
                            <span>@certificate.LessonTitle — @certificate.GeneratedAt.ToString("d MMMM yyyy")</span>
                            <span class="btn-row">
                                <a class="btn btn--quiet" href="@CertificateEndpoint.ViewUrl(certificate.CertificateId)" target="_blank" rel="noopener" aria-label="View certificate for @certificate.LessonTitle (opens in a new tab)" data-enhance-nav="false">View</a>
                                <a class="btn btn--quiet" href="@CertificateEndpoint.DownloadUrl(certificate.CertificateId)" aria-label="Download certificate for @certificate.LessonTitle" data-enhance-nav="false">Download</a>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
    </div>
}

@code {
    private List<ParentDashboardStudent> _students = new();
    private string? _errorMessage;

    private static string ConsentPill(Vlms.Domain.ConsentStatus status) => status switch
    {
        Vlms.Domain.ConsentStatus.Approved => "pill--success",
        Vlms.Domain.ConsentStatus.Pending => "pill--info",
        _ => "pill--warning",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _students = (await DashboardService.GetDashboardAsync()).ToList();
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
