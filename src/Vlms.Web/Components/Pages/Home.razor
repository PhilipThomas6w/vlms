@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Varangians LMS</h1>

<AuthorizeView>
    <NotAuthorized>
        <p>Welcome to the Varangians learning management system. Sign in to see your lessons and tasks.</p>
        <p><a href="/Account/Login">Log in</a></p>
    </NotAuthorized>
    <Authorized>
        <h2>What to do next</h2>

        <AuthorizeView Policy="RequireAdminOrSafeguardingOfficer" Context="consentContext">
            <PendingConsentNotice />
        </AuthorizeView>

        <AuthorizeView Policy="RequireTeacher" Context="roleContext">
            <section aria-labelledby="home-teacher">
                <h3 id="home-teacher">Teacher</h3>
                <ul>
                    <li><a href="/lessons">Lesson library</a></li>
                    <li><a href="/students">Students</a></li>
                    <li><a href="/progress/record">Record completions</a></li>
                    <li><a href="/curriculum/teacher">Propose lesson changes</a></li>
                    <li><a href="/progress/completions">Correct a completion</a></li>
                    <li><a href="/students/consent">Student consent and medical details</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireApprover" Context="roleContext">
            <section aria-labelledby="home-approver">
                <h3 id="home-approver">Approver</h3>
                <ul>
                    <li><a href="/curriculum/approver">Pending proposals</a></li>
                    <li><a href="/lessons">Lesson library</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireParent" Context="roleContext">
            <section aria-labelledby="home-parent">
                <h3 id="home-parent">Parent</h3>
                <ul>
                    <li><a href="/parent/dashboard">Parent dashboard</a></li>
                    <li><a href="/parent/consent">Consent form</a></li>
                    <li><a href="/lessons">Lesson library</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireStudent" Context="roleContext">
            <section aria-labelledby="home-student">
                <h3 id="home-student">Student</h3>
                <ul>
                    <li><a href="/student">My progress</a></li>
                    <li><a href="/lessons">Lesson library</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireSafeguardingOfficer" Context="roleContext">
            <section aria-labelledby="home-safeguarding">
                <h3 id="home-safeguarding">Safeguarding Officer</h3>
                <ul>
                    <li><a href="/registration/review">Review registration applications</a></li>
                    <li><a href="/safeguarding/consent">Consent records</a></li>
                    <li><a href="/safeguarding/dbs">DBS checks</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireAdmin" Context="roleContext">
            <section aria-labelledby="home-admin">
                <h3 id="home-admin">Admin</h3>
                <ul>
                    <li><a href="/administration/students">Manage students</a></li>
                    <li><a href="/administration/user-roles">User roles</a></li>
                    <li><a href="/registration/approve">Approve registration applications</a></li>
                    <li><a href="/registration/students">Register student</a></li>
                    <li><a href="/guardianship/links">Guardian links</a></li>
                    <li><a href="/administration/rank-badges">Rank badges</a></li>
                    <li><a href="/reporting">Reporting</a></li>
                    <li><a href="/reporting/records-due-for-deletion">Records due for deletion</a></li>
                    <li><a href="/retention/mark-as-left">Mark as left</a></li>
                    <li><a href="/safeguarding/consent">Consent records</a></li>
                    <li><a href="/safeguarding/dbs">DBS checks</a></li>
                    <li><a href="/lessons">Lesson library</a></li>
                </ul>
            </section>
        </AuthorizeView>
        <AuthorizeView Policy="RequireSignedIn" Context="applyContext">
            <section aria-labelledby="home-register">
                <h3 id="home-register">Register your child</h3>
                <p>Parents: apply to register your children with the Varangians, then follow your applications.</p>
                <ul>
                    <li><a href="/registration/apply">Register a child</a></li>
                    <li><a href="/registration/my-applications">My applications</a></li>
                </ul>
            </section>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>
