@page "/progress/record"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Attendance
@using Vlms.Infrastructure.Progress
@inject VlmsDbContext Db
@inject ICurrentUserContext CurrentUser
@inject CompletionService CompletionService
@inject AttendanceService Attendance

@* Recording lesson completions; redesign prototype (docs/design/redesign-direction.md, section 8). Same service call and
   checks as before: CompletionService decides; consent-blocked students are shown with the reason and
   can't be selected; nothing here changes who may record what. With the attendance register: the
   meeting's marks are shown, "Select everyone ready" takes only those present, and recording for a
   student marked absent needs the teacher to confirm it is a catch-up. *@

<PageTitle>Record completions – Varangians</PageTitle>

<div class="record">
    <PageHeader Title="Record completions">
        <Lead>Choose the lesson you taught, tick the students who completed it, then record them together. Certificates, promotions and parent emails follow automatically.</Lead>
    </PageHeader>

    @if (_errorMessage is not null)
    {
        <Notice Kind="danger" Role="alert"><p>@_errorMessage</p></Notice>
    }

    @if (_results is not null)
    {
        <div class="record__results" tabindex="-1" @ref="_resultsElement">
            <Notice Kind="@(_results.All(r => r.Outcome == CompletionOutcome.Completed) ? "success" : "warning")" Role="status">
                <p><strong>@ResultsHeadline()</strong></p>
                <ul>
                    @foreach (var result in _results)
                    {
                        <li>
                            @NameOf(result.StudentId):
                            @switch (result.Outcome)
                            {
                                case CompletionOutcome.Completed:
                                    <text>recorded@(result.Promoted ? $", promoted to {RankOf(result.StudentId)}" : "").</text>
                                    break;
                                case CompletionOutcome.AlreadyCompleted:
                                    <text>already completed.</text>
                                    break;
                                default:
                                    <text>not recorded: @result.Message</text>
                                    break;
                            }
                        </li>
                    }
                </ul>
            </Notice>
        </div>
    }

    @if (_marks.Count == 0)
    {
        <Notice Kind="info"><p>No register has been taken for @_meetingDate.ToString("d MMMM yyyy"). <a href="/attendance?date=@_meetingDate.ToString("yyyy-MM-dd")">Take the register</a> first to see who is here.</p></Notice>
    }
    else
    {
        <p class="muted">Register for @_meetingDate.ToString("d MMMM yyyy"): @_marks.Count(m => m.Value) present, @_marks.Count(m => !m.Value) absent.</p>
    }

    @* Step 1: the lesson, chosen by rank. *@
    <section class="record__step" aria-labelledby="step-lesson">
        <h2 id="step-lesson"><span class="record__num" aria-hidden="true">1</span> Lesson</h2>
        <fieldset class="rank-choice">
            <legend>Rank</legend>
            <div class="rank-choice__options">
                @foreach (var rank in _ranks)
                {
                    <label class="rank-choice__option rank-@rank.Order">
                        <input type="radio" name="rank" value="@rank.Id" checked="@(_rankId == rank.Id)" @onchange="() => ChooseRank(rank.Id)" />
                        <span>@rank.Name</span>
                    </label>
                }
            </div>
        </fieldset>

        @if (_rankId != 0)
        {
            <fieldset class="lesson-choice">
                <legend>@RankName(_rankId) lesson</legend>
                <ol class="lesson-choice__list">
                    @foreach (var lesson in _lessons.Where(l => l.RankId == _rankId).OrderBy(l => l.Order).ThenBy(l => l.Code))
                    {
                        <li>
                            <label class="lesson-choice__option">
                                <input type="radio" name="lesson" id="lesson@(lesson.Id)" value="@lesson.Id" checked="@(_lessonId == lesson.Id)" @onchange="() => ChooseLessonAsync(lesson.Id)" />
                                <span class="lesson-choice__order" aria-hidden="true">@lesson.Order</span>
                                <span class="lesson-choice__title">@lesson.Title</span>
                                <span class="lesson-choice__code">@lesson.Code</span>
                            </label>
                        </li>
                    }
                </ol>
            </fieldset>
        }
    </section>

    @* Step 2: the students. *@
    @if (_lessonId != 0)
    {
        var lessonRankId = _lessons.First(l => l.Id == _lessonId).RankId;
        var atRank = VisibleStudents.Where(s => s.CurrentRankId == lessonRankId).ToList();
        var others = VisibleStudents.Where(s => s.CurrentRankId != lessonRankId).ToList();

        <section class="record__step" aria-labelledby="step-students">
            <h2 id="step-students"><span class="record__num" aria-hidden="true">2</span> Students who completed @LessonTitle(_lessonId)</h2>

            <div class="record__tools">
                <label class="check" for="assignedToMe">
                    <input type="checkbox" id="assignedToMe" @bind="_assignedToMeOnly" @bind:after="ClearHiddenSelections" />
                    Only students assigned to me
                </label>
                <button type="button" class="btn--secondary" @onclick="() => SelectAllReady(atRank)" disabled="@(!atRank.Any(IsReadyAndHere))">
                    Select everyone @(_marks.Count > 0 ? "here and ready" : "ready") at @RankName(lessonRankId)
                </button>
            </div>

            @if (VisibleStudents.Count == 0)
            {
                <div class="empty"><p>No active students to show. @(_assignedToMeOnly ? "Untick \"Only students assigned to me\" to see everyone." : "")</p></div>
            }
            else
            {
                <fieldset class="students">
                    <legend>@RankName(lessonRankId) students (@atRank.Count)</legend>
                    @if (atRank.Count == 0)
                    {
                        <p class="muted">No students are at @RankName(lessonRankId) at the moment.</p>
                    }
                    <ul class="student-rows">
                        @foreach (var student in atRank) { @StudentRow(student, showRank: false) }
                    </ul>
                </fieldset>

                @if (others.Count > 0)
                {
                    <details class="others" open="@(others.Any(s => _selected.Contains(s.Id)))">
                        <summary>Students at other ranks (@others.Count)</summary>
                        <p class="muted others__hint">For example, a student who joined at a higher rank and is catching up on this lesson.</p>
                        <fieldset class="students">
                            <legend class="visually-hidden">Students at other ranks</legend>
                            <ul class="student-rows">
                                @foreach (var student in others) { @StudentRow(student, showRank: true) }
                            </ul>
                        </fieldset>
                    </details>
                }
            }
        </section>

        @if (SelectedAbsent.Count > 0)
        {
            <div class="record__absent">
                <Notice Kind="warning">
                    <p>@string.Join(", ", SelectedAbsent.Select(NameOf)) @(SelectedAbsent.Count == 1 ? "is" : "are") marked absent on the register for @_meetingDate.ToString("d MMMM yyyy").</p>
                    <label class="check" for="catchUp">
                        <input type="checkbox" id="catchUp" @bind="_catchUpConfirmed" />
                        Record @(SelectedAbsent.Count == 1 ? "it" : "them") anyway, as a catch-up
                    </label>
                </Notice>
            </div>
        }

        <div class="field record__note">
            <label for="completionNote">Note <span class="muted">(optional)</span></label>
            <span class="hint" id="completionNote-hint">Saved with each of these completions, for example a word on how the lesson went.</span>
            <input type="text" id="completionNote" aria-describedby="completionNote-hint" @bind="_note" />
        </div>

        @* Step 3: record. The bar stays in view while the list scrolls. *@
        <section class="record__bar" aria-labelledby="step-record">
            <h2 id="step-record" class="visually-hidden">Record</h2>
            <p class="record__selected">@(_selected.Count == 0 ? "No students selected" : _selected.Count == 1 ? "1 student selected" : $"{_selected.Count} students selected")</p>
            <button type="button" @onclick="SubmitAsync" disabled="@(_busy || _selected.Count == 0 || (SelectedAbsent.Count > 0 && !_catchUpConfirmed))">
                <Icon Name="record" />
                @(_busy ? "Recording…" : _selected.Count switch { 0 => "Record completions", 1 => "Record 1 completion", var n => $"Record {n} completions" })
            </button>
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "date")] public string? Date { get; set; }

    private DateOnly _meetingDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private IReadOnlyDictionary<int, bool> _marks = new Dictionary<int, bool>();
    private bool _catchUpConfirmed;
    private List<Lesson> _lessons = new();
    private List<Rank> _ranks = new();
    private List<Student> _students = new();
    private HashSet<int> _consentBlocked = new();
    private HashSet<int> _alreadyCompleted = new();
    private HashSet<int> _selected = new();
    private IReadOnlyList<StudentCompletionResult>? _results;
    private ElementReference _resultsElement;
    private bool _focusResults;
    private int _rankId;
    private int _lessonId;
    private bool _assignedToMeOnly;
    private bool _busy;
    private string? _note;
    private string? _errorMessage;

    private List<Student> VisibleStudents => _students
        .Where(s => !_assignedToMeOnly || (CurrentUser.UserId is not null && s.AssignedTeacherUserId == CurrentUser.UserId))
        .ToList();

    private RenderFragment StudentRow(Student student, bool showRank) => __builder =>
    {
        var blocked = _consentBlocked.Contains(student.Id);
        var already = _alreadyCompleted.Contains(student.Id);
        <li class="student-row @(blocked ? "is-blocked" : already ? "is-done" : null)">
            <input type="checkbox" id="student@(student.Id)"
                   checked="@_selected.Contains(student.Id)"
                   disabled="@(blocked || already)"
                   aria-describedby="@(blocked || already ? $"student{student.Id}-state" : null)"
                   @onchange="e => Toggle(student.Id, (bool)(e.Value ?? false))" />
            <label for="student@(student.Id)">
                <span class="student-row__name">@student.Name</span>
                @if (showRank && student.CurrentRank is { } rank)
                {
                    <RankPill Order="rank.Order" Name="@rank.Name" />
                }
            </label>
            @if (!blocked && !already && _marks.TryGetValue(student.Id, out var present))
            {
                <span class="student-row__state">
                    <span class="pill @(present ? "pill--success" : null)">@(present ? "Here" : "Absent")</span>
                </span>
            }
            @if (blocked)
            {
                <span class="student-row__state" id="student@(student.Id)-state">
                    <span class="pill pill--warning"><Icon Name="alert" /> Consent needed</span>
                    <span class="student-row__reason">Consent has lapsed or is missing, so completion can't be recorded.</span>
                </span>
            }
            else if (already)
            {
                <span class="student-row__state" id="student@(student.Id)-state">
                    <span class="pill pill--success"><Icon Name="check" /> Already completed</span>
                </span>
            }
        </li>
    };

    protected override async Task OnInitializedAsync()
    {
        _lessons = await Db.Lessons.AsNoTracking()
            .Include(l => l.Rank)
            .Where(l => l.IsActive)
            .ToListAsync();
        _ranks = _lessons.Select(l => l.Rank!).DistinctBy(r => r.Id).OrderBy(r => r.Order).ToList();
        await LoadStudentsAsync();
        await LoadConsentAsync();
        if (DateOnly.TryParseExact(Date, "yyyy-MM-dd", out var date) && date <= _meetingDate)
        {
            _meetingDate = date;
        }

        _marks = await Attendance.GetMarksAsync(_meetingDate);

        // Start at the rank most of the teacher's own students are at (or most students, if none are assigned).
        var mine = _students.Where(s => CurrentUser.UserId is not null && s.AssignedTeacherUserId == CurrentUser.UserId).ToList();
        _rankId = (mine.Count > 0 ? mine : _students)
            .Where(s => _ranks.Any(r => r.Id == s.CurrentRankId))
            .GroupBy(s => s.CurrentRankId)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResults)
        {
            _focusResults = false;
            await _resultsElement.FocusAsync();
        }
    }

    private async Task LoadStudentsAsync()
    {
        _students = await Db.Students.AsNoTracking()
            .Include(s => s.CurrentRank)
            .Where(s => s.Status == StudentStatus.Active)
            .OrderBy(s => s.Name)
            .ToListAsync();
    }

    private async Task LoadConsentAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var withConsent = await Db.ConsentRecords.AsNoTracking()
            .Where(c => c.Status == ConsentStatus.Approved && c.ExpiryDate >= today)
            .Select(c => c.StudentId)
            .Distinct()
            .ToListAsync();
        _consentBlocked = _students.Select(s => s.Id).Except(withConsent).ToHashSet();
    }

    private void ChooseRank(int rankId)
    {
        _rankId = rankId;
        if (_lessonId != 0 && _lessons.First(l => l.Id == _lessonId).RankId != rankId)
        {
            _lessonId = 0;
            _selected.Clear();
        }
    }

    private async Task ChooseLessonAsync(int lessonId)
    {
        _lessonId = lessonId;
        _results = null;
        _errorMessage = null;
        _selected.Clear();
        await LoadAlreadyCompletedAsync();
    }

    private async Task LoadAlreadyCompletedAsync()
    {
        _alreadyCompleted = _lessonId == 0
            ? new HashSet<int>()
            : (await Db.StudentLessonCompletions.AsNoTracking()
                .Where(c => c.LessonId == _lessonId && !c.IsReversed)
                .Select(c => c.StudentId)
                .ToListAsync()).ToHashSet();
    }

    private bool IsReady(Student student) => !_consentBlocked.Contains(student.Id) && !_alreadyCompleted.Contains(student.Id);

    // With a register taken, "everyone ready" means everyone ready who is marked present.
    private bool IsReadyAndHere(Student student) => IsReady(student) && (_marks.Count == 0 || _marks.GetValueOrDefault(student.Id));

    private List<int> SelectedAbsent => _selected.Where(id => _marks.TryGetValue(id, out var present) && !present).ToList();

    private void SelectAllReady(IEnumerable<Student> students)
    {
        foreach (var student in students.Where(IsReadyAndHere)) _selected.Add(student.Id);
    }

    // Hiding students (the "assigned to me" filter) must not leave hidden ones selected.
    private void ClearHiddenSelections() => _selected.IntersectWith(VisibleStudents.Select(s => s.Id));

    private void Toggle(int studentId, bool on)
    {
        if (on) { _selected.Add(studentId); } else { _selected.Remove(studentId); }
    }

    private string NameOf(int studentId) => _students.FirstOrDefault(s => s.Id == studentId)?.Name ?? $"Student {studentId}";
    private string RankOf(int studentId) => _students.FirstOrDefault(s => s.Id == studentId)?.CurrentRank?.Name ?? "the next rank";
    private string RankName(int rankId) => _ranks.FirstOrDefault(r => r.Id == rankId)?.Name ?? "";
    private string LessonTitle(int lessonId) => _lessons.FirstOrDefault(l => l.Id == lessonId)?.Title ?? "";

    private string ResultsHeadline()
    {
        var recorded = _results!.Count(r => r.Outcome == CompletionOutcome.Completed);
        var promoted = _results!.Count(r => r.Promoted);
        var text = recorded == 1 ? "1 completion recorded" : $"{recorded} completions recorded";
        if (promoted > 0) text += promoted == 1 ? ", 1 promotion" : $", {promoted} promotions";
        return text + ".";
    }

    private async Task SubmitAsync()
    {
        // A second click during a slow submit must not start a concurrent batch on the same DbContext.
        if (_busy || _lessonId == 0 || _selected.Count == 0)
        {
            return;
        }

        _busy = true;
        _errorMessage = null;
        try
        {
            // Render the disabled "Recording..." state before the slow batch starts.
            StateHasChanged();
            await Task.Yield();
            _results = await CompletionService.MarkCompleteBatchAsync(_selected.ToList(), _lessonId, _note);
            _selected.Clear();
            _note = null;
            _catchUpConfirmed = false;
            // Ranks may have changed (promotion): reload so the list and the result show the new rank.
            await LoadStudentsAsync();
            await LoadAlreadyCompletedAsync();
            _focusResults = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
