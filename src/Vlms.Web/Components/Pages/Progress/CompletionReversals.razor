@page "/progress/completions"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Vlms.Domain
@using Vlms.Infrastructure
@using Vlms.Infrastructure.Progress
@inject VlmsDbContext Db
@inject ICurrentUserContext CurrentUser
@inject CompletionService CompletionService

<PageTitle>My recorded completions</PageTitle>

<PageHeader Title="My recorded completions" />

<p class="intro">
    Lists lesson completions you personally recorded. You can self-correct/reverse your own entry
    within @CompletionService.DefaultReversalWindowDays days of recording it — no
    separate correction gate through Admin. A reversal excludes the completion from rank-promotion
    counting and hides any certificate it generated; it does not undo a promotion that already
    happened.
</p>

@if (_errorMessage is not null)
{
    <p class="error" role="alert">@_errorMessage</p>
}
@if (_statusMessage is not null)
{
    <p role="status">@_statusMessage</p>
}

<table class="data-table data-table--wide">
    <thead>
        <tr>
            <th>Student</th>
            <th>Lesson</th>
            <th>Completed</th>
            <th>Note</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var completion in _completions)
        {
            <tr>
                <td data-label="Student">@completion.Student?.Name</td>
                <td data-label="Lesson">@completion.Lesson?.Title</td>
                <td data-label="Completed">@completion.CompletedAt.ToString("g")</td>
                <td data-label="Note">@completion.Note</td>
                <td data-label="Status">
                    @if (completion.IsReversed)
                    {
                        <text>Reversed @completion.ReversedAt?.ToString("g")</text>
                    }
                    else
                    {
                        <text>Active</text>
                    }
                </td>
                <td>
                    @if (!completion.IsReversed)
                    {
                        <button type="button" class="btn--secondary" aria-label="@($"Reverse completion of {completion.Lesson?.Title} for {completion.Student?.Name}")" @onclick="() => StartReverse(completion)">Reverse</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_reversingCompletion is not null)
{
    <h2>Reverse completion: @_reversingCompletion.Student?.Name — @_reversingCompletion.Lesson?.Title</h2>
    <EditForm class="form" Model="_reversalForm" OnValidSubmit="ConfirmReverseAsync">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <div class="field">
            <label for="reversalNote">Reason (optional)</label>
            <InputTextArea id="reversalNote" @bind-Value="_reversalForm.Note" />
        </div>

        <div class="form-actions">
            <button type="submit">Confirm reversal</button>
            <button type="button" @onclick="CancelReverse" class="btn--secondary">Cancel</button>
        </div>
    </EditForm>
}

@code {
    private List<StudentLessonCompletion> _completions = new();
    private StudentLessonCompletion? _reversingCompletion;
    private ReversalFormModel _reversalForm = new();
    private string? _errorMessage;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var userId = CurrentUser.UserId;
        _completions = userId is null
            ? new List<StudentLessonCompletion>()
            : await Db.StudentLessonCompletions
                .Include(c => c.Student)
                .Include(c => c.Lesson)
                .Where(c => c.CompletedByUserId == userId)
                .OrderByDescending(c => c.CompletedAt)
                .Take(50)
                .ToListAsync();
    }

    private void StartReverse(StudentLessonCompletion completion)
    {
        _errorMessage = null;
        _statusMessage = null;
        _reversingCompletion = completion;
        _reversalForm = new ReversalFormModel();
    }

    private void CancelReverse()
    {
        _reversingCompletion = null;
        _errorMessage = null;
        _statusMessage = null;
    }

    private async Task ConfirmReverseAsync()
    {
        if (_reversingCompletion is null)
        {
            return;
        }

        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await CompletionService.ReverseAsync(_reversingCompletion.Id, _reversalForm.Note);
            _reversingCompletion = null;
            _statusMessage = "Completion reversed.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _errorMessage = ex.Message;
        }
    }

    private sealed class ReversalFormModel
    {
        public string? Note { get; set; }
    }
}
