        </AuthorizeView>
        <AuthorizeView Policy="RequireStudent">
            <li><a href="/student" aria-current="@Current("/student")">My progress</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireParent">
            <li><a href="/parent/dashboard" aria-current="@Current("/parent/dashboard")">Parent dashboard</a></li>
            <li><a href="/parent/consent" aria-current="@Current("/parent/consent")">Consent form</a></li>
            <li><a href="/parent/student-sign-ins" aria-current="@Current("/parent/student-sign-ins")">Student sign-ins</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireAdminOrTeacher">
            <li><a href="/students" aria-current="@Current("/students")">Students</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireTeacher">
            <li><a href="/students/consent" aria-current="@Current("/students/consent")">Student consent</a></li>
            <li><a href="/progress/record" aria-current="@Current("/progress/record")">Record completions</a></li>
            <li><a href="/progress/completions" aria-current="@Current("/progress/completions")">Correct a completion</a></li>
            <li><a href="/curriculum/teacher" aria-current="@Current("/curriculum/teacher")">Propose lesson changes</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireApprover">
            <li><a href="/curriculum/approver" aria-current="@Current("/curriculum/approver")">Pending proposals</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireAdminOrSafeguardingOfficer">
            <li><a href="/safeguarding/consent" aria-current="@Current("/safeguarding/consent")">Consent records</a></li>
            <li><a href="/safeguarding/dbs" aria-current="@Current("/safeguarding/dbs")">DBS checks</a></li>
        </AuthorizeView>
        <AuthorizeView Policy="RequireSafeguardingOfficer">
            <li><a href="/registration/review" aria-current="@Current("/registration/review")">Review registrations</a></li>
