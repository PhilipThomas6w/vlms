@implements IDisposable
@inject NavigationManager Navigation
@inject Vlms.Infrastructure.Curriculum.LessonSuggestionService Suggestions

@* Grouped by area; a group appears only for someone holding one of its roles. Every link sits in an
   AuthorizeView with exactly its page's policy (NavigationCoverageTests). Groups marked
   nav-group--staff turn the desktop layout into a sidebar (app.css). *@
<div id="site-nav" class="site-nav">
<nav aria-label="Main">
    <div class="nav-groups">
        <div class="nav-group">
            <ul class="nav-list">
                <li><a href="/" aria-current="@Current("/")"><Icon Name="home" /> Home</a></li>
                <AuthorizeView Policy="RequireStudent">
                    <li><a href="/student" aria-current="@Current("/student")"><Icon Name="rank" /> My rank</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="RequireChapterMember">
                    <li><a href="/calendar" aria-current="@Current("/calendar")"><Icon Name="calendar" /> Calendar</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="RequireLessonLibrary">
                    <li><a href="/lessons" aria-current="@Current("/lessons")"><Icon Name="book" /> Lesson library</a></li>
                </AuthorizeView>
            </ul>
        </div>

        <AuthorizeView Policy="RequireParent">
            <div class="nav-group">
                <span class="nav-group-label" id="nav-family">Family</span>
                <ul class="nav-list" aria-labelledby="nav-family">
                    <li><a href="/parent/dashboard" aria-current="@Current("/parent/dashboard")"><Icon Name="users" /> My children</a></li>
                    <li><a href="/parent/consent" aria-current="@Current("/parent/consent")"><Icon Name="clipboard" /> Consent form</a></li>
                    <li><a href="/parent/student-sign-ins" aria-current="@Current("/parent/student-sign-ins")"><Icon Name="key" /> Student sign-ins</a></li>
                </ul>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireAdminOrTeacher">
            <div class="nav-group nav-group--staff">
                <span class="nav-group-label" id="nav-teaching">Teaching</span>
                <ul class="nav-list" aria-labelledby="nav-teaching">
                    <li><a href="/attendance" aria-current="@Current("/attendance")"><Icon Name="clipboard" /> Registers</a></li>
                    <AuthorizeView Policy="RequireTeacher" Context="teacher">
                        <li><a href="/progress/record" aria-current="@Current("/progress/record")"><Icon Name="record" /> Record completions</a></li>
                    </AuthorizeView>
                    <li><a href="/students" aria-current="@Current("/students")"><Icon Name="users" /> Students</a></li>
                    <AuthorizeView Policy="RequireTeacher" Context="teacher">
                        <li><a href="/students/consent" aria-current="@Current("/students/consent")"><Icon Name="clipboard" /> Student consent</a></li>
                        <li><a href="/progress/completions" aria-current="@Current("/progress/completions")"><Icon Name="undo" /> Correct a completion</a></li>
                    </AuthorizeView>
                </ul>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireApprover">
            <div class="nav-group">
                <span class="nav-group-label" id="nav-curriculum">Curriculum</span>
                <ul class="nav-list" aria-labelledby="nav-curriculum">
                    <li><a href="/curriculum/review" aria-current="@Current("/curriculum/review")"><Icon Name="inbox" /> Changes to review
                        @if (_toReview > 0)
                        {
                            <span class="nav-count" aria-hidden="true">@_toReview</span><span class="visually-hidden">@($"({_toReview} awaiting review)")</span>
                        }
                    </a></li>
                </ul>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireAdminOrSafeguardingOfficer">
            <div class="nav-group nav-group--staff">
                <span class="nav-group-label" id="nav-safeguarding">Safeguarding</span>
                <ul class="nav-list" aria-labelledby="nav-safeguarding">
                    <AuthorizeView Policy="RequireSafeguardingOfficer" Context="officer">
                        <li><a href="/registration/review" aria-current="@Current("/registration/review")"><Icon Name="inbox" /> Review registrations</a></li>
                    </AuthorizeView>
                    <li><a href="/safeguarding/consent" aria-current="@Current("/safeguarding/consent")"><Icon Name="clipboard" /> Consent records</a></li>
                    <li><a href="/safeguarding/dbs" aria-current="@Current("/safeguarding/dbs")"><Icon Name="id-card" /> DBS checks</a></li>
                </ul>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireAdmin">
            <div class="nav-group nav-group--staff">
                <span class="nav-group-label" id="nav-admin">Administration</span>
                <ul class="nav-list" aria-labelledby="nav-admin">
                    <li><a href="/registration/approve" aria-current="@Current("/registration/approve")"><Icon Name="inbox" /> Approve registrations</a></li>
                    <li><a href="/registration/students" aria-current="@Current("/registration/students")"><Icon Name="user-plus" /> Register student</a></li>
                    <li><a href="/administration/students" aria-current="@Current("/administration/students")"><Icon Name="users" /> Manage students</a></li>
                    <li><a href="/guardianship/links" aria-current="@Current("/guardianship/links")"><Icon Name="link" /> Guardian links</a></li>
                    <li><a href="/administration/user-roles" aria-current="@Current("/administration/user-roles")"><Icon Name="shield" /> User roles</a></li>
                    <li><a href="/administration/student-sign-ins" aria-current="@Current("/administration/student-sign-ins")"><Icon Name="key" /> Student sign-ins</a></li>
                    <li><a href="/reporting" aria-current="@Current("/reporting")"><Icon Name="chart" /> Reporting</a></li>
                    <li><a href="/reporting/records-due-for-deletion" aria-current="@Current("/reporting/records-due-for-deletion")"><Icon Name="clock" /> Records due for deletion</a></li>
                    <li><a href="/retention/mark-as-left" aria-current="@Current("/retention/mark-as-left")"><Icon Name="user-minus" /> Mark as left</a></li>
                </ul>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="RequireNationalAdministrator">
            <div class="nav-group nav-group--staff">
                <span class="nav-group-label" id="nav-national">National</span>
                <ul class="nav-list" aria-labelledby="nav-national">
                    <li><a href="/administration/chapters" aria-current="@Current("/administration/chapters")"><Icon Name="home" /> Chapters</a></li>
                    <li><a href="/reporting/national" aria-current="@Current("/reporting/national")"><Icon Name="chart" /> National figures</a></li>
                    <li><a href="/administration/rank-badges" aria-current="@Current("/administration/rank-badges")"><Icon Name="image" /> Rank badges</a></li>
                    <li><a href="/administration/saints" aria-current="@Current("/administration/saints")"><Icon Name="calendar" /> Added saints</a></li>
                </ul>
            </div>
        </AuthorizeView>

        @* Any signed-in adult can apply to register their children (adr/0008). Not shown to a student
           sign-in, which can't apply; the pages refuse students regardless. *@
        <AuthorizeView Policy="RequireStudent" Context="student">
            <NotAuthorized>
                <div class="nav-group">
                    <span class="nav-group-label" id="nav-register">Registration</span>
                    <ul class="nav-list" aria-labelledby="nav-register">
                        <AuthorizeView Policy="RequireSignedIn" Context="signedIn">
                            <li><a href="/registration/apply" aria-current="@Current("/registration/apply")"><Icon Name="user-plus" /> Register a child</a></li>
                            <li><a href="/registration/my-applications" aria-current="@Current("/registration/my-applications")"><Icon Name="file" /> My applications</a></li>
                        </AuthorizeView>
                    </ul>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
</div>

@code {
    // Suggestions awaiting this Approver's decision (adr/0013 decision 8); zero for anyone else.
    private int _toReview;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _toReview = await Suggestions.CountAwaitingMyReviewAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    // aria-current="page" on the link for the current page; a null value omits the attribute.
    private string? Current(string href)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        if (path.Length == 0) path = "/";
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
