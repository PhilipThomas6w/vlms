@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="shell">
    @* The banner is the Greek Foliate Header (Orthodox Arts Journal), lengthened by repeating its roundels either side
       of the cross; the name and the account controls sit in its opening, between IC XC and NIKA. *@
    <header class="shell-bar">
        <span class="frieze frieze--left" aria-hidden="true"></span>
        <span class="frieze frieze--band" aria-hidden="true"><span class="frieze__fill frieze__fill--left"></span><span class="frieze__centre"></span><span class="frieze__fill frieze__fill--right"></span></span>
        <span class="frieze frieze--right" aria-hidden="true"></span>
        <div class="shell-bar__opening">
        <a class="brand" href="/"><BrandMark Letters="true" /><span class="brand__name">Varangians</span></a>
        <AuthorizeView>
            <Authorized>
                <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
                    <Icon Name="menu" /> <span class="nav-toggle__label">Menu</span>
                </button>
                <details class="account">
                    <summary>
                        <span class="initials" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                        <span class="account-name">@context.User.Identity?.Name</span>
                        <Icon Name="chevron-down" />
                    </summary>
                    <div class="account-menu">
                        <p>Signed in as @context.User.Identity?.Name</p>
                        @* Not for a student sign-in (no email claim, adr/0007): its parent sets its password,
                           and two-factor sign-in is for adults. *@
                        @if (context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Email))
                        {
                            <a href="/Account/Manage/TwoFactorAuthentication"><Icon Name="lock" /> Two-factor authentication</a>
                            <a href="/Account/Manage/ChangePassword"><Icon Name="key" /> Change password</a>
                        }
                        <form action="/Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="" />
                            <button type="submit"><Icon Name="log-out" /> Log out</button>
                        </form>
                    </div>
                </details>
            </Authorized>
            <NotAuthorized>
                <nav class="account-links" aria-label="Account">
                    <a href="/Account/Login">Log in</a>
                    <a href="/Account/Register">Register</a>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
        </div>
    </header>

    <div class="shell-body">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </div>

    <footer class="shell-foot">
        <Eagle />
        <p>Varangians: Orthodox formation for young people</p>
        <p class="shell-foot__credit">The banner's foliate header is from the Orthodox Illustration Project of the <a href="https://orthodoxartsjournal.org/orthodox-illustration-project/">Orthodox Arts Journal</a>.</p>
    </footer>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">🗙</button>
</div>

@code {
    // Two letters for the account button: "rachel.hughes" or "parent@capture.test" → "RH" / "PA".
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var local = name.Split('@')[0];
        var parts = local.Split(['.', ' ', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : local[..Math.Min(2, local.Length)].ToUpperInvariant();
    }
}
