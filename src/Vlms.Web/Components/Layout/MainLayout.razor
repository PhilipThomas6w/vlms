@inherits LayoutComponentBase

<header>
    <AuthorizeView>
        <Authorized>
            Signed in as @context.User.Identity?.Name
            — <a href="/Account/Manage/TwoFactorAuthentication">Two-factor authentication</a>
            @* Not for a student sign-in (no email claim, adr/0007): its parent sets its password. *@
            @if (context.User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Email))
            {
                <text>— <a href="/Account/Manage/ChangePassword">Change password</a></text>
            }
            — <form action="/Account/Logout" method="post" style="display:inline">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit">Log out</button>
            </form>
            <ChapterBar />
        </Authorized>
        <NotAuthorized>
            <a href="/Account/Login">Log in</a> | <a href="/Account/Register">Register</a>
        </NotAuthorized>
    </AuthorizeView>
    <NavMenu />
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">🗙</button>
</div>
