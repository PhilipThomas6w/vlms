@inherits LayoutComponentBase

<nav>
    <AuthorizeView>
        <Authorized>
            Signed in as @context.User.Identity?.Name
            — <a href="Account/Manage/TwoFactorAuthentication">Two-factor authentication</a>
            — <form action="Account/Logout" method="post" style="display:inline">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit">Log out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login">Log in</a> | <a href="Account/Register">Register</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@Body

<div id="blazor-error-ui" role="alert" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">🗙</button>
</div>
