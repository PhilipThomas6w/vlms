<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vlms.Domain\Vlms.Domain.csproj" />
    <ProjectReference Include="..\Vlms.Infrastructure\Vlms.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic host: configuration binding + console logging for the scheduled-job process
         (adr/0003-scheduled-jobs-webjobs.md, amended by adr/0005-hosting-pivot-self-hosted-vps-postgresql.md
         for the execution host). Not the WebJobs SDK (Microsoft.Azure.WebJobs) — that SDK's Azure
         Storage-backed dashboard/queue-trigger machinery was never needed even when this ran as an
         Azure WebJob; a plain console app, now triggered by a systemd timer
         (deploy/systemd/vlms-jobs.timer) rather than the Azure WebJobs folder convention, is the
         "fewest moving parts" realisation of the ADR. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
