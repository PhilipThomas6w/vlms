<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Verify's maintenance-fee check (SponsorCheck SC021). VLMS is an open-source project with no revenue
       (public repo, church youth group), so it claims the OpenSource exemption (Philip, 23/10/2026).
       Time-bounded by the package, at most 12 months out: renew before it lapses or the build fails. -->
  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <!-- Browser-driven UI tests (docs/ui-ux-redesign-toolchain.md). Kept apart from Vlms.Tests so
       build/verify.ps1 -Fast can skip them; they need a Playwright browser installed per machine
       (pwsh bin/Debug/net10.0/playwright.ps1 install chromium). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Verify.Playwright" Version="3.1.2" />
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <!-- Pinned up from the vulnerable 2.1.11 pulled in transitively (GHSA-2m69-gcr7-jv3q), as in Vlms.Tests -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same switch as Vlms.Tests: the host reads the test project's runtimeconfig, not Vlms.Web's. -->
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Components.Endpoints.NavigationManager.DisableThrowNavigationException" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vlms.Domain\Vlms.Domain.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Infrastructure\Vlms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Web\Vlms.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Baseline\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
