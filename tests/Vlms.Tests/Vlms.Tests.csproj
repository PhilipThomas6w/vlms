<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Pinned up from the vulnerable 2.1.11 pulled in transitively (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- ConfigurationBuilder/AddInMemoryCollection + GetValue<T> — proves the exact
         Safeguarding:ExpiryWarningWindowDays binding Vlms.Jobs/Program.cs uses to configure
         ConsentExpiryJob actually reads a non-default value from configuration. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <!-- In-memory TestServer for exercising Vlms.Web's real middleware registrations
         (WebHardening: rate limiting, HSTS) without Kestrel, a database or Program.cs's full host. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- Request-level end-to-end tests: WebApplicationFactory boots the real Program.cs pipeline. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vlms.Web.csproj sets BlazorDisableThrowNavigationException, which the SDK turns into this runtime
         switch in Vlms.Web's own runtimeconfig. The in-process test host reads the test project's
         runtimeconfig instead, so the same switch is set here; without it the end-to-end tests run
         with the framework default and cannot catch a redirect helper that still throws (the 22/10/2026
         "every sign-in answers 500" defect). -->
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Components.Endpoints.NavigationManager.DisableThrowNavigationException" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vlms.Domain\Vlms.Domain.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Infrastructure\Vlms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Web\Vlms.Web.csproj" />
  </ItemGroup>

</Project>