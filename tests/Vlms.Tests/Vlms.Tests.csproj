<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Pinned up from the vulnerable 2.1.11 pulled in transitively (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- ConfigurationBuilder/AddInMemoryCollection + GetValue<T> — proves the exact
         Safeguarding:ExpiryWarningWindowDays binding Vlms.Jobs/Program.cs uses to configure
         ConsentExpiryJob actually reads a non-default value from configuration. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <!-- Test-only, real in-process SMTP server on loopback (a real TcpListener, not a mock) —
         MailKit itself ships no stub server and its own FAQ names none (checked before adding this
         rather than assumed); netDumbster is the community-standard choice for exercising a real
         SmtpClient network path without a live remote mail server. Lets SmtpEmailSenderTests prove
         the actual Connect/Send/Disconnect conversation works, not just config binding/message
         construction — see that file's doc comment for what this can and can't simulate (no AUTH/
         STARTTLS support, so those failure paths are covered differently). -->
    <PackageReference Include="netDumbster" Version="3.1.1" />
    <!-- In-memory TestServer for exercising Vlms.Web's real middleware registrations
         (WebHardening: rate limiting, HSTS) without Kestrel, a database or Program.cs's full host. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vlms.Domain\Vlms.Domain.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Infrastructure\Vlms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vlms.Web\Vlms.Web.csproj" />
  </ItemGroup>

</Project>